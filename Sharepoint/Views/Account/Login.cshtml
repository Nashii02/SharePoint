@model LoginViewModel
@{
    Layout = null;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>
    * {
        font-family: 'DM Sans', sans-serif;
    }

    .dot-pattern {
        background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1.5px, transparent 1.5px);
        background-size: 24px 24px;
    }

    .input-field:focus {
        outline: none;
        border-color: #1B2A6B;
        box-shadow: 0 0 0 3px rgba(27,42,107,0.12);
    }
    /* Scrollbar thin */
    ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }
</style>

<div class="min-h-screen flex">
    <!-- LEFT SIDE - Navy Blue with Dots -->
    <div class="hidden md:flex md:w-1/2 bg-[#1B2A6B] dot-pattern flex-col p-8 relative overflow-hidden">
        
        <div class="absolute right-20 pointer-events-none hidden md:block">
            <img src="~/images/NoBGLogo.png"
                 class="w-100 h-100 object-contain filter brightness-0 invert opacity-[0.07] translate-y-8" />
        </div>


        <!-- Branding section at bottom -->
        <div class="mt-auto">
            <div class="flex items-center gap-3 mb-5">
                <div class="w-12 h-12 rounded-lg bg-white/15 flex items-center justify-center">
                        <img src="~/images/NoBGLogo.png"
                             class="w-8 h-8 object-contain filter brightness-0 invert"
                             alt="Logo" />
                    </div>
                <div>
                    <p class="text-[11px] font-semibold text-blue-200 uppercase tracking-widest">IT Solutions</p>
                    <p class="text-base font-bold text-white">Work Instructions</p>
                </div>
            </div>
            <p class="text-blue-200/70 text-sm leading-relaxed max-w-xs">
                Streamline your workflow and access all work instructions in one secure platform.
            </p>
        </div>
    </div>

    <!-- RIGHT SIDE - White Modal -->
    <div class="w-full md:w-1/2 flex items-center justify-center p-4 bg-[#F4F6FB]">
        <div class="w-full max-w-sm">
            <!-- Mobile back button -->
            <a href="/Home/WorkInstruction"
               class="flex md:hidden items-center gap-1.5 text-xs text-[#1B2A6B]/60 hover:text-[#1B2A6B] transition mb-4 w-fit">
                <i class="fa-solid fa-arrow-left text-[10px]"></i>
                Back to Work Instructions
            </a>

            <div class="bg-white rounded-2xl overflow-hidden"
                 style="border:1px solid #E8EAF0; box-shadow: 0 20px 60px rgba(27,42,107,0.15);">

                <!-- Header -->
                <div class="bg-[#1B2A6B] px-8 py-7 text-white relative overflow-hidden">
                    <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full opacity-[0.06]" style="background:white;"></div>
                    <div class="relative z-10">
                        <h1 class="text-2xl font-bold tracking-tight">Welcome back</h1>
                        <p class="text-blue-200/70 text-xs mt-1">Sign in to your account</p>
                    </div>
                </div>

                <div class="px-8 py-7">

                    <!-- Error messages -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-4 rounded-lg bg-red-50 border border-red-100 px-4 py-3 flex items-start gap-2.5">
                            <i class="fa-solid fa-circle-exclamation text-red-400 text-sm mt-0.5 flex-shrink-0"></i>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <p class="text-xs text-red-600">@error.ErrorMessage</p>
                                }
                            </div>
                        </div>
                    }

                    <!-- LOGIN FORM -->
                    <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="text-[11px] font-semibold text-[#1B2A6B] block mb-1.5">Email address</label>
                            <div class="relative">
                                <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-xs"></i>
                                <input asp-for="Email" type="email" placeholder="you@company.com"
                                       class="input-field w-full border border-gray-200 rounded-lg pl-9 pr-4 py-2.5 text-sm text-gray-700 transition bg-[#FAFBFF]" />
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="text-[11px] font-semibold text-[#1B2A6B] block mb-1.5">Password</label>
                            <div class="relative">
                                <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-xs"></i>
                                <input asp-for="Password" type="password" id="login-password"
                                       placeholder="••••••••"
                                       class="input-field w-full border border-gray-200 rounded-lg pl-9 pr-10 py-2.5 text-sm text-gray-700 transition bg-[#FAFBFF]" />
                                <button type="button" onclick="togglePassword('login-password', 'eye-login')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-300 hover:text-gray-500 transition">
                                    <i id="eye-login" class="fa-solid fa-eye text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input asp-for="RememberMe" type="checkbox" class="w-3.5 h-3.5 rounded border-gray-300 accent-[#1B2A6B]" />
                                <span class="text-xs text-gray-500">Remember me</span>
                            </label>
                        </div>

                        <button type="submit"
                                class="w-full bg-[#1B2A6B] hover:bg-[#152255] text-white text-sm font-semibold py-2.5 rounded-lg transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i>
                            Sign in
                        </button>
                    </form>

                    <!-- Create Account Link -->
                    <div class="mt-6 pt-6 flex items-center justify-center" style="border-top: 1px solid #F0F1F5;">
                        <p class="text-xs text-gray-500">
                            Don't have an account?
                            <a href="/Account/Register"
                               class="font-semibold text-[#1B2A6B] hover:text-[#152255] transition">
                                Create one here
                            </a>
                        </p>
                    </div>

                    <!-- Guest Login Option -->
                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-xs text-gray-500 text-center mb-3">Or continue as a guest</p>
                        <button type="button" onclick="showGuestModal()"
                                class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold py-2.5 rounded-lg transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-user-secret text-xs"></i>
                            Continue as Guest
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- GUEST LOGIN MODAL -->
<div id="guest-modal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center"
     style="background: rgba(8,10,20,0.85); backdrop-filter: blur(4px);">

    <div class="bg-white rounded-2xl w-full max-w-sm p-8 relative"
         style="border: 1px solid #E8EAF0; box-shadow: 0 20px 60px rgba(27,42,107,0.15);">

        <button type="button" onclick="closeGuestModal()"
                class="absolute top-4 right-4 w-7 h-7 rounded-lg flex items-center justify-center transition"
                style="background: #F5F6FA; border: 1px solid #E8EAF0;">
            <i class="fa-solid fa-xmark text-gray-400 text-sm"></i>
        </button>

        <div class="mb-6">
            <h2 class="text-xl font-bold text-[#1B2A6B]">Continue as Guest</h2>
            <p class="text-xs text-gray-500 mt-1">You can browse and comment without an account</p>
        </div>

        <form method="post" asp-action="LoginAsGuest" id="guest-form">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="text-[11px] font-semibold text-[#1B2A6B] block mb-1.5">
                    Display Name <span class="text-gray-300 font-normal">(optional)</span>
                </label>
                <input type="text" name="Nickname" placeholder="e.g., Alex, John..."
                       maxlength="50"
                       class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-700 transition bg-[#FAFBFF]"
                       style="outline: none;"
                       onfocus="this.style.borderColor='#1B2A6B'; this.style.boxShadow='0 0 0 3px rgba(27,42,107,0.12)';"
                       onblur="this.style.borderColor='#E5E7EB'; this.style.boxShadow='none';" />
                <p class="text-[10px] text-gray-400 mt-1">Leave blank for auto-assigned name (Guest1, Guest2, etc.)</p>
            </div>

            <p class="text-[11px] text-gray-500 mb-4 p-3 rounded-lg" style="background: #FAFBFF; border-left: 3px solid #1B2A6B;">
                <i class="fa-solid fa-info-circle text-[#1B2A6B] mr-1.5"></i>
                You can comment on work instructions and interact with content as a guest. No account or email required.
            </p>

            <button type="submit"
                    class="w-full bg-[#1B2A6B] hover:bg-[#152255] text-white text-sm font-semibold py-2.5 rounded-lg transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i>
                Continue
            </button>
        </form>

    </div>
</div>

<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        input.type  = input.type === 'password' ? 'text' : 'password';
        icon.className = input.type === 'password'
            ? 'fa-solid fa-eye text-xs'
            : 'fa-solid fa-eye-slash text-xs';
    }

    function showGuestModal() {
        document.getElementById('guest-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeGuestModal() {
        document.getElementById('guest-modal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.getElementById('guest-modal').addEventListener('click', function(e) {
        if (e.target === this) closeGuestModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeGuestModal();
    });
</script>