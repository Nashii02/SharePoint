@model UserManagementViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@{
    Layout = null;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
    * {
        font-family: 'DM Sans', sans-serif;
    }

    .hero-texture {
        background-image: radial-gradient(circle, rgba(255,255,255,0.10) 1px, transparent 1px);
        background-size: 22px 22px;
    }

    select:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(27,42,107,0.12);
    }

    ::-webkit-scrollbar {
        width: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }
</style>

@{
    var currentUserId = UserManager.GetUserId(User);
}

<div class="min-h-screen flex flex-col bg-[#F4F6FB]">

    <!-- HERO -->
    <section class="bg-[#1B2A6B] text-white relative overflow-hidden"
             style="box-shadow: 0 4px 24px rgba(27,42,107,0.22);">
        <div class="hero-texture absolute inset-0 pointer-events-none"></div>

        <div class="relative max-w-7xl mx-auto px-8">

            <!-- Navbar -->
            <div class="flex items-center justify-between py-4"
                 style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-white/15 flex items-center justify-center">
                        <i class="fa-solid fa-shield-halved text-white text-sm"></i>
                    </div>
                    <span class="text-sm font-semibold text-white/90 tracking-tight">IT Solutions</span>
                    <span class="text-white/20 text-xs">|</span>
                    <span class="text-xs text-blue-300/80 font-medium">Admin Panel</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5 text-xs text-white/50">
                        <i class="fa-solid fa-user text-[10px]"></i>
                        <span>@User.Identity?.Name</span>
                    </div>
                    <form method="post" asp-controller="Account" asp-action="Logout" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-lg transition"
                                style="background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.15);">
                            <i class="fa-solid fa-right-from-bracket text-[10px]"></i>
                            Sign out
                        </button>
                    </form>
                </div>
            </div>

            <!-- Breadcrumb + Title -->
            <div class="py-8">
                <nav class="inline-flex items-center gap-2 text-xs mb-4">
                    <a href="/Home/WorkInstruction"
                       class="text-blue-300 hover:text-white transition">
                        Work Instructions
                    </a>
                    <i class="fa-solid fa-chevron-right text-[8px] text-blue-400/60"></i>
                    <span class="text-white/80 font-medium">User Management</span>
                </nav>
                <h1 class="text-4xl font-bold tracking-tight leading-none">
                    USER<br />MANAGEMENT
                </h1>
                <p class="text-blue-200/60 text-sm mt-3">Manage accounts and assign roles.</p>
            </div>
        </div>
    </section>

    <!-- BODY -->
    <div class="flex-1 py-8">
        <div class="max-w-7xl mx-auto px-8">

            <!-- Stats row -->
            <div class="flex items-center gap-4 mb-6 flex-wrap">
                <div class="bg-white rounded-xl px-4 py-3 flex items-center gap-3"
                     style="border: 1px solid #E8EAF0;">
                    <div class="w-8 h-8 rounded-lg bg-[#EEF2FF] flex items-center justify-center">
                        <i class="fa-solid fa-users text-[#1B2A6B] text-sm"></i>
                    </div>
                    <div>
                        <p class="text-[10px] text-gray-400">Total Users</p>
                        <p class="text-lg font-bold text-[#1B2A6B]">@Model.Users.Count</p>
                    </div>
                </div>

                @foreach (var role in Model.AllRoles)
                {
                    var count = Model.Users.Count(u => u.Role == role);
                    var (bg, text, icon) = role switch
                    {
                        "Admin" => ("bg-[#EEF2FF]", "text-[#1B2A6B]", "fa-solid fa-user-shield"),
                        "Quality Assurance" => ("bg-purple-50", "text-purple-700", "fa-solid fa-user-check"),
                        "User" => ("bg-sky-50", "text-sky-700", "fa-solid fa-user"),
                        "Guest" => ("bg-amber-50", "text-amber-700", "fa-solid fa-user-secret"),
                        _ => ("bg-gray-50", "text-gray-500", "fa-solid fa-user")
                    };
                    <div class="bg-white rounded-xl px-4 py-3 flex items-center gap-3"
                         style="border: 1px solid #E8EAF0;">
                        <div class="w-8 h-8 rounded-lg @bg flex items-center justify-center">
                            <i class="@icon @text text-sm"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-gray-400">@role</p>
                            <p class="text-lg font-bold text-[#1B2A6B]">@count</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Search + Filter row -->
            <div class="flex items-center gap-3 mb-4 flex-wrap">

                <!-- Search -->
                <div class="bg-white rounded-xl px-4 py-3 flex items-center gap-2"
                     style="border: 1px solid #E8EAF0; min-width: 260px;">
                    <i class="fa-solid fa-magnifying-glass text-gray-300 text-xs"></i>
                    <input type="text" id="user-search" placeholder="Search by email or name..."
                           oninput="filterUsers()"
                           class="text-xs bg-transparent flex-1 text-gray-600" style="outline:none;" />
                </div>

                <!-- Role filter tabs -->
                <div class="flex items-center gap-1 bg-white rounded-xl p-1"
                     style="border: 1px solid #E8EAF0;">

                    <button type="button" onclick="setFilter('all')" id="filter-all"
                            class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-lg transition active-filter">
                        All
                    </button>

                    @foreach (var role in Model.AllRoles)
                    {
                        <button type="button"
                                onclick="setFilter('@role.ToLower()')"
                                id="filter-@role.ToLower().Replace(" ", "-")"
                                class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-lg transition">
                            @role
                        </button>
                    }
                </div>
            </div>

            <!-- User table -->
            <div class="bg-white rounded-xl overflow-hidden" style="border: 1px solid #E8EAF0;">

                <div class="px-5 py-3 flex items-center justify-between"
                     style="border-bottom: 1px solid #F0F1F5; border-top: 3px solid #1B2A6B;">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-users text-[#1B2A6B] text-sm"></i>
                        <p class="text-sm font-semibold text-[#1B2A6B]">Accounts</p>
                    </div>
                    <span id="user-count"
                          class="text-[10px] font-semibold bg-[#EEF2FF] text-[#1B2A6B] px-2.5 py-1 rounded-full">
                        @Model.Users.Count user(s)
                    </span>
                </div>

                @if (Model.Users.Any())
                {
                    <div class="grid grid-cols-12 px-5 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest"
                         style="background: #FAFBFF; border-bottom: 1px solid #F0F1F5;">
                        <div class="col-span-5">Name / Email</div>
                        <div class="col-span-4">Role</div>
                        <div class="col-span-3 text-right">Actions</div>
                    </div>

                    <ul id="user-list" class="divide-y divide-gray-50">
                        @foreach (var user in Model.Users)
                        {
                            var isSelf = user.Id == currentUserId;
                            var (roleBg, roleText) = user.Role switch
                            {
                                "Admin" => ("bg-[#EEF2FF]", "text-[#1B2A6B]"),
                                "Quality Assurance" => ("bg-purple-50", "text-purple-700"),
                                "User" => ("bg-sky-50", "text-sky-700"),
                                "Guest" => ("bg-amber-50", "text-amber-700"),
                                _ => ("bg-gray-100", "text-gray-400")
                            };

                            <li class="user-row grid grid-cols-12 items-center px-5 py-3.5 hover:bg-[#F8F9FF] transition"
                                data-email="@user.Email.ToLower()"
                                data-name="@user.DisplayName.ToLower()"
                                data-role="@user.Role.ToLower()">

                                <!-- Email / Name -->
                                <div class="col-span-5 flex items-center gap-3 min-w-0">
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0"
                                         style="background: @(isSelf ? "#1B2A6B" : user.IsGuest ? "#FCD34D" : "#EEF2FF");">
                                        <i class="fa-solid fa-@(user.IsGuest ? "user-secret" : "user") text-xs"
                                           style="color: @(isSelf ? "white" : user.IsGuest ? "#B45309" : "#1B2A6B");"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-[#1B2A6B] truncate">@user.DisplayName</p>
                                        @if (isSelf)
                                        {
                                            <p class="text-[10px] text-gray-400">You</p>
                                        }
                                        @if (user.IsGuest && user.IsBanned)
                                        {
                                            <p class="text-[10px] text-red-500 font-semibold">
                                                <i class="fa-solid fa-ban text-[8px]"></i> Banned
                                            </p>
                                        }
                                    </div>
                                </div>

                                <!-- Role badge -->
                                <div class="col-span-4">
                                    <span class="text-[10px] font-bold px-2.5 py-1 rounded-full @roleBg @roleText">
                                        @user.Role
                                    </span>
                                </div>

                                <!-- Actions -->
                                <div class="col-span-3 flex items-center justify-end gap-2">
                                    @if (isSelf)
                                    {
                                        <span class="text-[10px] text-gray-300 italic">Cannot edit own account</span>
                                    }
                                    else if (user.IsGuest)
                                    {
                                        <!-- Guests cannot change role, only delete or ban -->
                                        @if (!user.IsBanned)
                                        {
                                            <form method="post" action="/Account/BanGuest" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="guestId" value="@(int.Parse(user.Id.Replace("guest-", "")))" />
                                                <input type="hidden" name="reason" value="Banned by admin" />
                                                <button type="submit"
                                                        onclick="return confirm('Ban @user.DisplayName from commenting?')"
                                                        class="w-7 h-7 rounded-lg bg-yellow-50 hover:bg-yellow-100 flex items-center justify-center transition"
                                                        title="Ban guest">
                                                    <i class="fa-solid fa-ban text-yellow-600 text-[10px]"></i>
                                                </button>
                                            </form>
                                        }

                                        <form method="post" action="/Account/DeleteUser" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit"
                                                    onclick="return confirm('Delete @user.DisplayName? This cannot be undone.')"
                                                    class="w-7 h-7 rounded-lg bg-red-50 hover:bg-red-100 flex items-center justify-center transition"
                                                    title="Delete user">
                                                <i class="fa-solid fa-trash text-red-400 text-[10px]"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <!-- Registered users can change role -->
                                        <form method="post" action="/Account/ChangeRole">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="newRole"
                                                    onchange="this.form.submit()"
                                                    class="text-xs border border-gray-200 rounded-lg px-2 py-1.5 text-gray-600 transition"
                                                    style="background:#FAFBFF;">
                                                @foreach (var role in Model.AllRoles.Where(r => r != "Guest"))
                                                {
                                                    if (role == user.Role)
                                                    {
                                                        <option value="@role" selected>@role</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@role">@role</option>
                                                    }
                                                }
                                            </select>
                                        </form>

                                        <form method="post" action="/Account/DeleteUser">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit"
                                                    onclick="return confirm('Delete @user.Email? This cannot be undone.')"
                                                    class="w-7 h-7 rounded-lg bg-red-50 hover:bg-red-100 flex items-center justify-center transition"
                                                    title="Delete user">
                                                <i class="fa-solid fa-trash text-red-400 text-[10px]"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    <!-- No results after filter -->
                    <div id="no-users-found" style="display:none;"
                         class="px-5 py-12 text-center">
                        <div class="w-12 h-12 rounded-2xl bg-[#EEF2FF] flex items-center justify-center mx-auto mb-3">
                            <i class="fa-solid fa-magnifying-glass text-[#1B2A6B] text-lg"></i>
                        </div>
                        <p class="text-sm font-semibold text-gray-500">No users found</p>
                        <p class="text-xs text-gray-400 mt-1">Try a different search or filter</p>
                    </div>
                }
                else
                {
                    <div class="px-5 py-16 text-center">
                        <div class="w-14 h-14 rounded-2xl bg-[#EEF2FF] flex items-center justify-center mx-auto mb-4">
                            <i class="fa-solid fa-users text-[#1B2A6B] text-xl"></i>
                        </div>
                        <p class="text-sm font-semibold text-gray-500">No users yet</p>
                        <p class="text-xs text-gray-400 mt-1">Users will appear here once they register or continue as guests.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<style>
    .active-filter {
        background: #1B2A6B;
        color: white;
    }

    .filter-btn:not(.active-filter) {
        color: #6b7280;
    }

        .filter-btn:not(.active-filter):hover {
            background: #F5F6FA;
            color: #1B2A6B;
        }
</style>

<script>
    let activeFilter = 'all';

    function setFilter(role) {
        activeFilter = role;

        // Update tab styles
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active-filter');
        });

        const activeId = role === 'all'
            ? 'filter-all'
            : 'filter-' + role.replace(/ /g, '-');

        const activeBtn = document.getElementById(activeId);
        if (activeBtn) activeBtn.classList.add('active-filter');

        filterUsers();
    }

    function filterUsers() {
        const query = (document.getElementById('user-search').value || '').toLowerCase().trim();
        const rows  = document.querySelectorAll('.user-row');
        let visible = 0;

        rows.forEach(row => {
            const email    = row.getAttribute('data-email') || '';
            const name     = row.getAttribute('data-name')  || '';
            const role     = row.getAttribute('data-role')  || '';
            const matchSearch = email.includes(query) || name.includes(query);
            const matchFilter = activeFilter === 'all' || role === activeFilter;

            const show = matchSearch && matchFilter;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        document.getElementById('user-count').textContent = visible + ' user(s)';

        const noFound = document.getElementById('no-users-found');
        if (noFound) noFound.style.display = visible === 0 ? 'block' : 'none';
    }
</script>