@model List<Sharepoint.Models.AppUser>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="max-w-5xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-[#1C3667]">Manage Users</h1>
        <p class="text-sm text-gray-400 mt-1">View, search, and manage all registered users.</p>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="bg-[#1C3667] rounded-xl px-5 py-4 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs text-white font-bold uppercase tracking-wide mb-1">Total Users</p>
                <p class="text-2xl font-bold text-white">@Model.Count</p>
            </div>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.8">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
        </div>
        <div class="bg-green-500 rounded-xl px-5 py-4 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs text-white font-bold uppercase tracking-wide mb-1">Active</p>
                <p class="text-2xl font-bold text-white">@Model.Count(u => u.IsActive)</p>
            </div>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.8">
                <circle cx="12" cy="12" r="10" />
                <polyline points="9 12 11 14 15 10" />
            </svg>
        </div>
        <div class="bg-red-400 rounded-xl px-5 py-4 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs text-white font-bold uppercase tracking-wide mb-1">Deactivated</p>
                <p class="text-2xl font-bold text-white">@Model.Count(u => !u.IsActive)</p>
            </div>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.8">
                <circle cx="12" cy="12" r="10" />
                <line x1="15" y1="9" x2="9" y2="15" />
                <line x1="9" y1="9" x2="15" y2="15" />
            </svg>
        </div>
    </div>

    <!-- Filter pills -->
    <div class="flex items-center gap-2 mb-4">
        <button onclick="filterStatus('all')" data-filter="all"
                class="filter-pill px-4 py-1.5 rounded-full text-xs font-semibold border transition-colors active-pill">
            All
        </button>
        <button onclick="filterStatus('active')" data-filter="active"
                class="filter-pill px-4 py-1.5 rounded-full text-xs font-semibold border border-gray-200 text-gray-500 hover:border-[#1C3667] hover:text-[#1C3667] transition-colors">
            Active
        </button>
        <button onclick="filterStatus('deactivated')" data-filter="deactivated"
                class="filter-pill px-4 py-1.5 rounded-full text-xs font-semibold border border-gray-200 text-gray-500 hover:border-[#1C3667] hover:text-[#1C3667] transition-colors">
            Deactivated
        </button>
    </div>

    <!-- No results -->
    <div id="noResults" class="hidden text-center text-gray-400 py-12 text-sm">
        <svg class="mx-auto mb-3 opacity-30" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
        </svg>
        No users match your search.
    </div>

    <!-- Table -->
    <div class="rounded-xl overflow-hidden border border-gray-200 shadow-sm">
        <table class="w-full text-sm" id="userTable">
            <thead>
                <tr class="bg-[#1C3667] text-white">
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Username</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Display Name</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Role</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Status</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Active</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="user-row border-b border-gray-100 transition-colors hover:bg-[#f0f7f0] @(user.IsActive ? "bg-white" : "bg-red-50")"
                        data-username="@(user.Username?.ToLower() ?? "")"
                        data-displayname="@(user.DisplayName?.ToLower() ?? "")"
                        data-role="@(user.Role?.ToLower() ?? "")"
                        data-status="@(user.IsActive ? "active" : "deactivated")">

                        <!-- Avatar + Username -->
                        <td class="px-5 py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-[#DDF0DD] text-[#1C3667] text-xs font-bold flex items-center justify-center flex-shrink-0">
                                    @(user.Username != null && user.Username.Length > 0 ? user.Username.Substring(0, 2).ToUpper() : "?")
                                </div>
                                <span class="font-medium text-gray-800">@user.Username</span>
                            </div>
                        </td>

                        <td class="px-5 py-3 text-gray-600">@user.DisplayName</td>

                        <td class="px-5 py-3">
                            <span class="px-2 py-1 rounded-md text-xs font-semibold
                                    @(user.Role == "Admin" ? "bg-[#1C3667] text-white" : "bg-gray-100 text-gray-600")">
                                @user.Role
                            </span>
                        </td>

                        <td class="px-5 py-3">
                            @if (user.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 text-green-700 font-semibold text-xs">
                                    <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 text-red-500 font-semibold text-xs">
                                    <span class="w-2 h-2 rounded-full bg-red-400 inline-block"></span>
                                    Deactivated
                                </span>
                            }
                        </td>

                        <!-- Toggle -->
                        <td class="px-5 py-3">
                            @if (user.Role != "Admin")
                            {
                                <form method="post" asp-controller="Account" asp-action="ToggleUserStatus">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" title="@(user.IsActive ? "Deactivate user" : "Activate user")"
                                            onclick="return confirm('@(user.IsActive ? $"Deactivate {user.Username}? They will no longer be able to log in." : $"Restore {user.Username}? They will be able to log in again.")')"
                                            class="relative inline-flex items-center w-11 h-6 rounded-full transition-colors focus:outline-none @(user.IsActive ? "bg-green-500" : "bg-gray-300")">
                                        <span class="inline-block w-4 h-4 bg-white rounded-full shadow transform transition-transform @(user.IsActive ? "translate-x-6" : "translate-x-1")"></span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-gray-300 text-xs">—</span>
                            }
                        </td>

                        <!-- Delete -->
                        <td class="px-5 py-3">
                            @if (user.Role != "Admin")
                            {
                                <form method="post" asp-controller="Account" asp-action="DeleteUser">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit"
                                            title="Delete user permanently"
                                            onclick="return confirm('Permanently delete @user.Username? This cannot be undone.')"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-red-500 rounded-lg hover:bg-red-600 transition-colors">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                        Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-gray-300 text-xs">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Row count -->
    <p id="rowCount" class="text-xs text-gray-400 mt-3 text-right"></p>
</div>

<style>
    .active-pill {
        background: #1C3667;
        color: white;
        border-color: #1C3667;
    }
</style>

<script>
    const searchInput = document.getElementById('globalSearch');
    const rows = document.querySelectorAll('.user-row');
    const noResults = document.getElementById('noResults');
    const rowCount = document.getElementById('rowCount');
    const filterPills = document.querySelectorAll('.filter-pill');

    let currentFilter = 'all';

    function applyFilters() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
            const matchesSearch = !query ||
                row.dataset.username.includes(query) ||
                row.dataset.displayname.includes(query) ||
                row.dataset.role.includes(query) ||
                row.dataset.status.includes(query);

            const matchesFilter = currentFilter === 'all' || row.dataset.status === currentFilter;

            const visible = matchesSearch && matchesFilter;
            row.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
        });

        noResults.classList.toggle('hidden', visibleCount > 0);
        rowCount.textContent = visibleCount > 0 ? `Showing ${visibleCount} user${visibleCount !== 1 ? 's' : ''}` : '';
    }

    function filterStatus(status) {
        currentFilter = status;
        filterPills.forEach(pill => {
            const isActive = pill.dataset.filter === status;
            pill.classList.toggle('active-pill', isActive);
            pill.classList.toggle('border-gray-200', !isActive);
            pill.classList.toggle('text-gray-500', !isActive);
        });
        applyFilters();
    }

    searchInput.addEventListener('input', applyFilters);
    applyFilters();
</script>