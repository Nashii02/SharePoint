@model List<Sharepoint.Models.AppUser>
@{
    ViewData["Title"] = "Manage Users";
}

<style>
    .active-pill {
        background: #1C3667;
        color: white;
        border-color: #1C3667;
    }

        .active-pill:hover {
            background: #162d57;
            color: white !important;
        }

    body {
        background-color: #edffed !important;
    }

    #userTable tbody tr.bg-white {
        background-color: #ddf0dd !important;
    }

    #userTable tbody tr.bg-red-50 {
        background-color: #fef2f2 !important;
    }

    #userTable tbody tr:hover {
        background-color: #c8e6c8 !important;
    }
</style>

<div class="max-w-5xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-[#1C3667]">Manage Users</h1>
        <p class="text-sm text-gray-400 mt-1">View, search, and manage all registered users.</p>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="bg-[#1C3667] rounded-xl px-5 py-4 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs text-white font-bold uppercase tracking-wide mb-1">Total Users</p>
                <p class="text-2xl font-bold text-white">@Model.Count</p>
            </div>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.8">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
        </div>
        <div class="bg-green-500 rounded-xl px-5 py-4 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs text-white font-bold uppercase tracking-wide mb-1">Active</p>
                <p class="text-2xl font-bold text-white">@Model.Count(u => u.IsActive)</p>
            </div>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.8">
                <circle cx="12" cy="12" r="10" />
                <polyline points="9 12 11 14 15 10" />
            </svg>
        </div>
        <div class="bg-red-400 rounded-xl px-5 py-4 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs text-white font-bold uppercase tracking-wide mb-1">Deactivated</p>
                <p class="text-2xl font-bold text-white">@Model.Count(u => !u.IsActive)</p>
            </div>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.8">
                <circle cx="12" cy="12" r="10" />
                <line x1="15" y1="9" x2="9" y2="15" />
                <line x1="9" y1="9" x2="15" y2="15" />
            </svg>
        </div>
    </div>

    <!-- Filter pills -->
    <div class="flex items-center gap-2 mb-4">
        <button onclick="filterStatus('all')" data-filter="all"
                class="filter-pill px-4 py-1.5 rounded-full text-xs font-semibold border transition-colors active-pill">
            All
        </button>
        <button onclick="filterStatus('active')" data-filter="active"
                class="filter-pill px-4 py-1.5 rounded-full text-xs font-semibold border border-gray-200 text-gray-500 hover:border-white hover:text-[#1C3667] transition-colors">
            Active
        </button>
        <button onclick="filterStatus('deactivated')" data-filter="deactivated"
                class="filter-pill px-4 py-1.5 rounded-full text-xs font-semibold border border-gray-200 text-gray-500 hover:border-white hover:text-[#1C3667] transition-colors">
            Deactivated
        </button>
    </div>

    <!-- No results -->
    <div id="noResults" class="hidden text-center text-gray-400 py-12 text-sm">
        <svg class="mx-auto mb-3 opacity-30" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
        </svg>
        No users match your search.
    </div>

    <!-- Table -->
    <div class="rounded-xl overflow-hidden border border-gray-200 shadow-sm">
        <table class="w-full text-sm" id="userTable">
            <thead>
                <tr class="bg-[#1C3667] text-white">
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Username</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Display Name</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Role</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Status</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Active</th>
                    <th class="px-5 py-3 text-left font-semibold text-xs uppercase tracking-wide">Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="user-row border-b border-gray-100 transition-colors hover:bg-[#f0f7f0] @(user.IsActive ? "bg-white" : "bg-red-50")"
                        data-username="@(user.Username?.ToLower() ?? "")"
                        data-displayname="@(user.DisplayName?.ToLower() ?? "")"
                        data-role="@(user.Role?.ToLower() ?? "")"
                        data-status="@(user.IsActive ? "active" : "deactivated")">

                        <td class="px-5 py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-white text-[#1C3667] text-xs font-bold flex items-center justify-center flex-shrink-0">
                                    @(user.Username != null && user.Username.Length > 0 ? user.Username.Substring(0, 2).ToUpper() : "?")
                                </div>
                                <span class="font-medium text-gray-800">@user.Username</span>
                            </div>
                        </td>

                        <td class="px-5 py-3 text-gray-600">@user.DisplayName</td>

                        <td class="px-5 py-3">
                            <span class="px-2 py-1 rounded-md text-xs font-semibold
                                    @(user.Role == "Admin" ? "bg-[#1C3667] text-white" : "bg-gray-100 text-gray-600")">
                                @user.Role
                            </span>
                        </td>

                        <td class="px-5 py-3">
                            @if (user.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 text-green-700 font-semibold text-xs">
                                    <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 text-red-500 font-semibold text-xs">
                                    <span class="w-2 h-2 rounded-full bg-red-400 inline-block"></span>
                                    Deactivated
                                </span>
                            }
                        </td>

                        <!-- Toggle -->
                        <td class="px-5 py-3">
                            @if (user.Role != "Admin")
                            {
                                <form method="post" asp-controller="Account" asp-action="ToggleUserStatus">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" title="@(user.IsActive ? "Deactivate user" : "Activate user")"
                                            onclick="return confirm('@(user.IsActive ? $"Deactivate {user.Username}? They will no longer be able to log in." : $"Restore {user.Username}? They will be able to log in again.")')"
                                            class="relative inline-flex items-center w-11 h-6 rounded-full transition-colors focus:outline-none @(user.IsActive ? "bg-green-500" : "bg-gray-300")">
                                        <span class="inline-block w-4 h-4 bg-white rounded-full shadow transform transition-transform @(user.IsActive ? "translate-x-6" : "translate-x-1")"></span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-gray-300 text-xs">—</span>
                            }
                        </td>

                        <!-- Delete -->
                        <td class="px-5 py-3">
                            @if (user.Role != "Admin")
                            {
                                <button type="button"
                                        onclick="openDeleteModal(@user.Id, '@user.Username')"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-red-500 rounded-lg hover:bg-red-600 transition-colors">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="pointer-events:none;">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                    </svg>
                                    Delete
                                </button>
                            }
                            else
                            {
                                <span class="text-gray-300 text-xs">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Row count -->
    <p id="rowCount" class="text-xs text-gray-400 mt-3 text-right"></p>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:18px; padding:36px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.2);">

        <!-- Icon + Title -->
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <div style="width:44px;height:44px;background:#fef2f2;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#b91c1c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">
                    <polyline points="3 6 5 6 21 6" />
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                    <path d="M10 11v6M14 11v6" />
                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                </svg>
            </div>
            <div>
                <h3 style="font-size:17px;font-weight:700;color:#1C3667;margin:0;">Delete User?</h3>
                <p id="deleteModalSubtitle" style="font-size:12px;color:#6b7280;margin:2px 0 0 0;"></p>
            </div>
        </div>

        <p style="font-size:13px;color:#6b7280;margin:0 0 20px 0;line-height:1.6;">
            This action is <strong>permanent</strong> and cannot be undone. Please enter your admin password to confirm.
        </p>

        <!-- Password input -->
        <div style="margin-bottom:8px;">
            <label style="font-size:11px;font-weight:700;color:#1C3667;text-transform:uppercase;letter-spacing:0.6px;display:block;margin-bottom:6px;">
                Admin Password
            </label>
            <div style="position:relative;">
                <input type="password" id="deleteAdminPassword" placeholder="Enter your password"
                       style="width:100%;padding:11px 40px 11px 14px;font-size:14px;color:#1C3667;background:#f7fff7;border:1.5px solid #c8e6d4;border-radius:10px;outline:none;box-sizing:border-box;" />
                <button type="button" onclick="toggleDeletePw()" tabindex="-1"
                        style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#a0b8a8;display:flex;align-items:center;padding:0;">
                    <svg id="deletePwEyeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;pointer-events:none;">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Error message -->
        <p id="deletePasswordError" style="display:none;font-size:12px;color:#b91c1c;font-weight:600;margin-bottom:16px;"></p>

        <!-- Actions -->
        <div style="display:flex;gap:12px;margin-top:20px;">
            <button type="button" onclick="closeDeleteModal()"
                    style="flex:1;padding:11px;font-size:14px;font-weight:700;background:#f3f4f6;color:#374151;border:none;border-radius:10px;cursor:pointer;">
                Cancel
            </button>
            <button type="button" onclick="submitDelete()"
                    style="flex:1;padding:11px;font-size:14px;font-weight:700;background:#b91c1c;color:white;border:none;border-radius:10px;cursor:pointer;">
                Delete User
            </button>
        </div>

        <!-- Hidden form that actually submits -->
        <form id="deleteForm" method="post" asp-controller="Account" asp-action="DeleteUser" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteUserId" />
            <input type="hidden" name="adminPassword" id="deletePasswordField" />
        </form>
    </div>
</div>

<style>
    .active-pill {
        background: #1C3667;
        color: white;
        border-color: #1C3667;
    }
</style>

<script>
    // ── Filters ──────────────────────────────────────────────
    const searchInput = document.getElementById('globalSearch');
    const rows = document.querySelectorAll('.user-row');
    const noResults = document.getElementById('noResults');
    const rowCount = document.getElementById('rowCount');
    const filterPills = document.querySelectorAll('.filter-pill');

    let currentFilter = 'all';

    function applyFilters() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
            const matchesSearch = !query ||
                row.dataset.username.includes(query) ||
                row.dataset.displayname.includes(query) ||
                row.dataset.role.includes(query) ||
                row.dataset.status.includes(query);

            const matchesFilter = currentFilter === 'all' || row.dataset.status === currentFilter;

            const visible = matchesSearch && matchesFilter;
            row.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
        });

        noResults.classList.toggle('hidden', visibleCount > 0);
        rowCount.textContent = visibleCount > 0 ? `Showing ${visibleCount} user${visibleCount !== 1 ? 's' : ''}` : '';
    }

    function filterStatus(status) {
        currentFilter = status;
        filterPills.forEach(pill => {
            const isActive = pill.dataset.filter === status;
            pill.classList.toggle('active-pill', isActive);
            pill.classList.toggle('border-gray-200', !isActive);
            pill.classList.toggle('text-gray-500', !isActive);
        });
        applyFilters();
    }

    searchInput.addEventListener('input', applyFilters);
    applyFilters();

    // ── Delete Modal ──────────────────────────────────────────
    function openDeleteModal(userId, username) {
        document.getElementById('deleteUserId').value = userId;
        document.getElementById('deleteModalSubtitle').textContent = `Deleting: ${username}`;
        document.getElementById('deleteAdminPassword').value = '';
        document.getElementById('deletePasswordError').style.display = 'none';
        document.getElementById('deleteModal').style.display = 'flex';
        setTimeout(() => document.getElementById('deleteAdminPassword').focus(), 100);
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        document.getElementById('deleteAdminPassword').value = '';
        document.getElementById('deletePasswordError').style.display = 'none';
    }

    function toggleDeletePw() {
        const input = document.getElementById('deleteAdminPassword');
        const icon = document.getElementById('deletePwEyeIcon');
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        icon.innerHTML = isHidden
            ? `<line x1="1" y1="1" x2="23" y2="23"/><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>`
            : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
    }

    async function submitDelete() {
        const password = document.getElementById('deleteAdminPassword').value.trim();
        const errorEl = document.getElementById('deletePasswordError');

        if (!password) {
            errorEl.textContent = 'Please enter your password.';
            errorEl.style.display = 'block';
            return;
        }

        // Verify password via a small fetch call before submitting the real form
        const verifyResponse = await fetch('/Account/VerifyAdminPassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('#deleteForm [name="__RequestVerificationToken"]').value },
            body: JSON.stringify({ password })
        });

        if (!verifyResponse.ok) {
            errorEl.textContent = 'Incorrect password. Please try again.';
            errorEl.style.display = 'block';
            document.getElementById('deleteAdminPassword').value = '';
            document.getElementById('deleteAdminPassword').focus();
            return;
        }

        // Password verified — submit the real delete form
        errorEl.style.display = 'none';
        document.getElementById('deletePasswordField').value = password;
        document.getElementById('deleteForm').submit();
    }

    // Allow Enter key to confirm
    document.getElementById('deleteAdminPassword').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') submitDelete();
    });

    // Close modal on backdrop click
    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) closeDeleteModal();
    });
</script>