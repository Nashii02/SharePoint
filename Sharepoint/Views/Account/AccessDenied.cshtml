@{
    ViewData["Title"] = Model.ModuleTitle;
    Layout = null;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
<style>
    * {
        font-family: 'DM Sans', sans-serif;
    }</style>

<div class="min-h-screen bg-[#F4F6FB] flex items-center justify-center">
    <div class="text-center">
        <div class="w-16 h-16 rounded-2xl bg-red-50 flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-ban text-red-400 text-2xl"></i>
        </div>
        <h1 class="text-xl font-bold text-[#1B2A6B] mb-1">Access Denied</h1>
        <p class="text-sm text-gray-400 mb-5">You don't have permission to view this page.</p>
        <a href="/Home/WorkInstruction"
           class="bg-[#1B2A6B] text-white text-xs font-semibold px-5 py-2.5 rounded-lg hover:bg-[#152255] transition inline-block">
            <i class="fa-solid fa-house mr-1.5"></i> Back to Home
        </a>
    </div>
</div>