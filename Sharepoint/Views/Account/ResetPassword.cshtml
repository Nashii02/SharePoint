@{
    ViewData["Title"] = "Reset Password";
}

<script src="https://cdn.tailwindcss.com"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap');

    * {
        box-sizing: border-box;
    }

    body, .reset-root {
        font-family: 'Barlow', sans-serif;
        min-height: 100vh;
        background: #ECFFEC;
        margin: 0;
    }

    .reset-root {
        display: flex;
        min-height: 100vh;
    }

    .reset-left {
        position: relative;
        width: 55%;
        background: #1C3667;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 60px 64px;
        overflow: hidden;
    }

    .circuit-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0) invert(1);
        opacity: 0.08;
        z-index: 0;
    }

    .logo-mask {
        position: absolute;
        right: -5px;
        bottom: 220px;
        width: 420px;
        height: 420px;
        mask-image: url('/images/NoBGLogo.png');
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
        opacity: 0.12;
        z-index: 1;
    }

        .logo-mask img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0) invert(1);
        }

    .logo-ghost {
        position: absolute;
        right: -5px;
        bottom: 220px;
        width: 420px;
        height: 420px;
        object-fit: contain;
        filter: brightness(0) invert(1);
        opacity: 0.08;
        z-index: 2;
    }

    .left-content {
        position: relative;
        z-index: 3;
    }

    .brand-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 56px;
    }

    .brand-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .brand-name {
        font-family: 'Barlow', sans-serif;
        font-weight: 700;
        font-size: 18px;
        color: white;
        letter-spacing: 0.5px;
    }

    .left-headline {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 62px;
        line-height: 1;
        letter-spacing: -1px;
        color: white;
        margin: 0 0 24px 0;
    }

    .left-sub {
        font-size: 15px;
        color: rgba(255,255,255,0.6);
        max-width: 340px;
        line-height: 1.65;
        margin: 0;
    }

    .tip-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 40px;
    }

    .tip-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tip-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        border: 1.5px solid rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .tip-dot svg {
            width: 10px;
            height: 10px;
            color: white;
        }

    .tip-item span {
        font-size: 13px;
        color: rgba(255,255,255,0.65);
    }

    .dot-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 40px;
    }

    .dot-row {
        display: flex;
        gap: 10px;
    }

    .dot {
        width: 7px;
        height: 7px;
        background: rgba(255,255,255,0.45);
        border-radius: 50%;
    }

    .reset-right {
        width: 45%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 60px 48px;
        background: #ECFFEC;
    }

    .reset-card {
        width: 100%;
        max-width: 400px;
        background: white;
        border: 1.5px solid #c8e6d4;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(28, 54, 103, 0.08);
    }

    .reset-card-header {
        background: #1C3667;
        padding: 28px 32px;
    }

        .reset-card-header h2 {
            font-family: 'Barlow', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: white;
            margin: 0 0 4px 0;
        }

        .reset-card-header p {
            font-size: 13px;
            color: rgba(255,255,255,0.55);
            margin: 0;
        }

    .reset-card-body {
        padding: 32px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #1C3667;
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input {
            width: 100%;
            padding: 11px 14px;
            font-family: 'Barlow', sans-serif;
            font-size: 14px;
            color: #1C3667;
            background: #f7fff7;
            border: 1.5px solid #c8e6d4;
            border-radius: 10px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-group input:focus {
                border-color: #1C3667;
                box-shadow: 0 0 0 3px rgba(28,54,103,0.08);
                background: white;
            }

            .form-group input::placeholder {
                color: #a0b8a8;
            }

            .form-group input.has-icon {
                padding-right: 38px;
            }

            .form-group input.invalid {
                border-color: #fca5a5;
                background: #fff5f5;
            }

            .form-group input.valid {
                border-color: #86efac;
            }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap svg.field-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: #a0b8a8;
            pointer-events: none;
        }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        color: #a0b8a8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .toggle-password:hover {
            color: #1C3667;
        }

    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }

    .strength-bar {
        display: flex;
        gap: 4px;
        margin-top: 6px;
    }

    .strength-segment {
        flex: 1;
        height: 3px;
        border-radius: 99px;
        background: #e5e7eb;
        transition: background 0.3s;
    }

    .strength-label {
        font-size: 11px;
        color: #a0b8a8;
        margin-top: 4px;
    }

    .field-error {
        font-size: 11px;
        color: #dc2626;
        margin-top: 4px;
        display: none;
    }

    .btn-submit {
        width: 100%;
        padding: 13px;
        background: #1C3667;
        color: white;
        font-family: 'Barlow', sans-serif;
        font-size: 15px;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        letter-spacing: 0.3px;
        transition: background 0.2s, transform 0.1s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-submit:hover {
            background: #162d57;
        }

        .btn-submit:active {
            transform: scale(0.98);
        }

        .btn-submit svg {
            width: 16px;
            height: 16px;
        }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: #c8e6d4;
    }

    .divider span {
        font-size: 12px;
        color: #a0b8a8;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .back-row {
        text-align: center;
    }

        .back-row p {
            font-size: 13px;
            color: #6b8a75;
            margin: 0;
        }

        .back-row a {
            color: #1C3667;
            font-weight: 700;
            text-decoration: none;
        }

            .back-row a:hover {
                text-decoration: underline;
            }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff5f5;
        border: 1.5px solid #fca5a5;
        border-radius: 10px;
        padding: 11px 14px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #b91c1c;
    }

        .error-banner svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    @@media (max-width: 768px) {
        .reset-root {
            flex-direction: column;
        }

        .reset-left {
            width: 100%;
            min-height: 220px;
            padding: 36px 32px;
        }

            .reset-left .left-headline {
                font-size: 42px;
            }

        .reset-right {
            width: 100%;
            padding: 32px 20px;
        }

        .dot-grid, .tip-list {
            display: none;
        }
    }
</style>

<div class="reset-root">

    <div class="reset-left">
        <img src="~/images/circuit.png" class="circuit-bg" alt="" />
        <div class="logo-mask">
            <img src="~/images/circuit.png" alt="" />
        </div>
        <img src="~/images/NoBGLogo.png" class="logo-ghost" alt="" />

        <div class="left-content">
            <div class="brand-row">
                <img src="~/images/NoBGLogo.png" class="brand-logo" alt="Logo" />
                <span class="brand-name">IT SOLUTIONS</span>
            </div>

            <h1 class="left-headline">CREATE<br />NEW<br />PASSWORD</h1>
            <p class="left-sub">Choose a strong password to keep your account secure.</p>

            <div class="tip-list">
                <div class="tip-item">
                    <div class="tip-dot">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>
                    <span>At least 6 characters long</span>
                </div>
                <div class="tip-item">
                    <div class="tip-dot">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>
                    <span>Mix uppercase letters and numbers</span>
                </div>
                <div class="tip-item">
                    <div class="tip-dot">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>
                    <span>Use special characters for extra strength</span>
                </div>
            </div>

            <div class="dot-grid">
                <div class="dot-row">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="dot"></div>
                    }
                </div>
                <div class="dot-row">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="dot"></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="reset-right">
        <div class="reset-card">
            <div class="reset-card-header">
                <h2>Set new password</h2>
                <p>Enter and confirm your new password below</p>
            </div>

            <div class="reset-card-body">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="error-banner">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form method="post" asp-controller="Account" asp-action="ResetPassword" id="resetForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    <div class="form-group">
                        <label for="password">New Password <span style="color:#dc2626;">*</span></label>
                        <div class="input-icon-wrap">
                            <input type="password" id="password" name="password"
                                   class="has-icon"
                                   placeholder="Min. 6 characters"
                                   autocomplete="new-password"
                                   required minlength="6"
                                   oninput="checkStrength(this.value)" />
                            <button type="button" class="toggle-password" onclick="togglePass('password','eyeIcon1')" aria-label="Toggle password">
                                <svg id="eyeIcon1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <div class="strength-bar">
                            <div class="strength-segment" id="s1"></div>
                            <div class="strength-segment" id="s2"></div>
                            <div class="strength-segment" id="s3"></div>
                            <div class="strength-segment" id="s4"></div>
                        </div>
                        <div class="strength-label" id="strengthLabel">Enter a password</div>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password <span style="color:#dc2626;">*</span></label>
                        <div class="input-icon-wrap">
                            <input type="password" id="confirmPassword" name="confirmPassword"
                                   class="has-icon"
                                   placeholder="Re-enter password"
                                   autocomplete="new-password"
                                   required />
                            <button type="button" class="toggle-password" onclick="togglePass('confirmPassword','eyeIcon2')" aria-label="Toggle confirm password">
                                <svg id="eyeIcon2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <div class="field-error" id="confirmError">Passwords do not match</div>
                    </div>

                    <button type="submit" class="btn-submit" id="submitBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        Save New Password
                    </button>
                </form>

                <div class="divider">
                    <div class="divider-line"></div>
                    <span>or</span>
                    <div class="divider-line"></div>
                </div>

                <div class="back-row">
                    <p>Remembered your password? <a href="/Account/Login">Sign in</a></p>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    function togglePass(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        icon.innerHTML = isHidden
            ? `<line x1="1" y1="1" x2="23" y2="23"/><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>`
            : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
    }

    function checkStrength(val) {
        const segs = [document.getElementById('s1'), document.getElementById('s2'), document.getElementById('s3'), document.getElementById('s4')];
        const label = document.getElementById('strengthLabel');
        const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e'];
        const labels = ['Too short', 'Weak', 'Fair', 'Strong'];

        let score = 0;
        if (val.length >= 6) score++;
        if (val.length >= 10) score++;
        if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        segs.forEach((s, i) => {
            s.style.background = i < score ? colors[score - 1] : '#e5e7eb';
        });

        label.textContent = val.length === 0 ? 'Enter a password' : labels[score - 1] ?? 'Too short';
        label.style.color = val.length === 0 ? '#a0b8a8' : colors[score - 1] ?? '#ef4444';
    }

    document.getElementById('confirmPassword').addEventListener('input', function () {
        const pw = document.getElementById('password').value;
        const err = document.getElementById('confirmError');
        if (this.value && this.value !== pw) {
            this.classList.add('invalid');
            this.classList.remove('valid');
            err.style.display = 'block';
        } else if (this.value === pw && this.value.length > 0) {
            this.classList.remove('invalid');
            this.classList.add('valid');
            err.style.display = 'none';
        } else {
            this.classList.remove('invalid', 'valid');
            err.style.display = 'none';
        }
    });

    document.getElementById('resetForm').addEventListener('submit', function (e) {
        const pw = document.getElementById('password').value;
        const cpw = document.getElementById('confirmPassword').value;
        if (pw !== cpw) {
            e.preventDefault();
            document.getElementById('confirmPassword').classList.add('invalid');
            document.getElementById('confirmError').style.display = 'block';
            return;
        }
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin" style="width:16px;height:16px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Saving…`;
    });
</script>
