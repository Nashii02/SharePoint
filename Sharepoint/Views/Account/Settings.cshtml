@{
    ViewData["Title"] = "Settings";
    var profileModel = ViewBag.ProfileModel as Sharepoint.Models.EditProfileViewModel ?? new Sharepoint.Models.EditProfileViewModel();
    var passwordModel = ViewBag.PasswordModel as Sharepoint.Models.ChangePasswordViewModel ?? new Sharepoint.Models.ChangePasswordViewModel();
    bool hasAvatar = ViewBag.HasAvatar == true;
    int userId = (int)(ViewBag.UserId ?? 0);
    string username = ViewBag.Username ?? "User";
    string initials = username.Length >= 2 ? username.Substring(0, 2).ToUpper() : username.ToUpper();
}

<script src="https://cdn.tailwindcss.com"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body, .settings-root {
        font-family: 'Barlow', sans-serif;
        min-height: 100vh;
        background: #ECFFEC;
        margin: 0;
    }

    .settings-root {
        display: flex;
        min-height: 100vh;
    }

    /* ── LEFT PANEL ── */
    .settings-left {
        position: relative;
        width: 300px;
        min-width: 260px;
        background: #1C3667;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 48px 32px 40px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .circuit-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0) invert(1);
        opacity: 0.06;
        z-index: 0;
    }

    .left-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .brand-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 48px;
        align-self: flex-start;
    }

    .brand-logo {
        width: 36px;
        height: 36px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .brand-name {
        font-weight: 700;
        font-size: 14px;
        color: white;
        letter-spacing: 0.5px;
    }

    .avatar-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #DDF0DD; /* ← was rgba(255,255,255,0.12) */
        border: 3px solid rgba(255,255,255,0.25);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-initials {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 34px;
        color: #1C3667; /* ← was white */
    }

    .left-username {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 22px;
        color: white;
        text-align: center;
        margin: 0 0 32px 0;
    }

    /* Nav */
    .side-nav {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .side-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
        }

            .side-nav a:hover, .side-nav a.active {
                background: rgba(255,255,255,0.1);
                color: white;
            }

            .side-nav a svg {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
            }

    /* ── MAIN ── */
    .settings-main {
        flex: 1;
        padding: 48px 48px 48px 40px;
        overflow-y: auto;
    }

    .page-heading {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 42px;
        color: #1C3667;
        letter-spacing: -1px;
        margin: 0 0 4px 0;
        line-height: 1;
    }

    .page-subheading {
        font-size: 14px;
        color: #6b8a75;
        margin: 0 0 32px 0;
    }

    /* Flash messages */
    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 24px;
    }

        .alert svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    .alert-success {
        background: #f0fdf4;
        border: 1.5px solid #86efac;
        color: #166534;
    }

    .alert-error {
        background: #fff5f5;
        border: 1.5px solid #fca5a5;
        color: #b91c1c;
    }

    /* Cards */
    .card {
        background: white;
        border: 1.5px solid #c8e6d4;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 16px rgba(28,54,103,0.06);
        margin-bottom: 24px;
    }

    .card-header {
        background: #1C3667;
        padding: 20px 28px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .card-header svg {
            width: 18px;
            height: 18px;
            color: rgba(255,255,255,0.7);
            flex-shrink: 0;
        }

        .card-header h3 {
            font-family: 'Barlow', sans-serif;
            font-weight: 700;
            font-size: 15px;
            color: white;
            margin: 0;
        }

    .card-body {
        padding: 28px;
    }

    /* Form elements */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 11px;
            font-weight: 700;
            color: #1C3667;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="password"],
        .form-group input[type="file"] {
            width: 100%;
            padding: 11px 14px;
            font-family: 'Barlow', sans-serif;
            font-size: 14px;
            color: #1C3667;
            background: #f7fff7;
            border: 1.5px solid #c8e6d4;
            border-radius: 10px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-group input:focus {
            border-color: #1C3667;
            box-shadow: 0 0 0 3px rgba(28,54,103,0.08);
            background: white;
        }

        .form-group input::placeholder {
            color: #a0b8a8;
        }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap > svg {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 15px;
            height: 15px;
            color: #a0b8a8;
            pointer-events: none;
            z-index: 1; /* ADD THIS */
        }

        .input-icon-wrap input {
            padding-right: 38px;
        }

    .toggle-pw {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #a0b8a8;
        display: flex;
        align-items: center;
        padding: 0;
        z-index: 2; /* ADD THIS */
    }

        .toggle-pw:hover {
            color: #1C3667;
        }

        .toggle-pw svg {
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

    /* Avatar preview */
    .avatar-preview-row {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 16px;
    }

    .avatar-preview {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        border: 2px solid #DDF0DD;
        overflow: hidden;
        background: #DDF0DD; /* changed */
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .avatar-preview-initials {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 26px;
        color: #1C3667; /* changed */
    }

        .avatar-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-preview-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .avatar-preview-info span {
            font-size: 12px;
            color: #6b8a75;
        }

    /* Checkbox */
    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: #fff5f5;
        border: 1.5px solid #fca5a5;
        border-radius: 10px;
        cursor: pointer;
        margin-top: 8px;
    }

        .checkbox-row input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #b91c1c;
            cursor: pointer;
            flex-shrink: 0;
        }

        .checkbox-row span {
            font-size: 13px;
            font-weight: 600;
            color: #b91c1c;
        }

    /* Buttons */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: #1C3667;
        color: white;
        font-family: 'Barlow', sans-serif;
        font-size: 14px;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

        .btn-primary:hover {
            background: #162d57;
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        .btn-primary svg {
            width: 15px;
            height: 15px;
        }

    .btn-danger {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: #b91c1c;
        color: white;
        font-family: 'Barlow', sans-serif;
        font-size: 14px;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

        .btn-danger:hover {
            background: #991b1b;
        }

        .btn-danger:active {
            transform: scale(0.98);
        }

        .btn-danger svg {
            width: 15px;
            height: 15px;
        }

    /* Danger zone */
    .danger-zone {
        background: white;
        border: 1.5px solid #fca5a5;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 16px rgba(185,28,28,0.06);
        margin-bottom: 24px;
    }

        .danger-zone .card-header {
            background: #b91c1c;
        }

    .danger-text {
        font-size: 13px;
        color: #6b7280;
        margin: 0 0 20px 0;
        line-height: 1.6;
    }

    /* Field hint */
    .field-hint {
        font-size: 11px;
        color: #a0b8a8;
        margin-top: 2px;
    }

    /* Validation */
    .field-error {
        font-size: 12px;
        color: #b91c1c;
        margin-top: 2px;
        font-weight: 600;
    }

    /* Password strength */
    .strength-bar {
        height: 4px;
        border-radius: 4px;
        background: #e5e7eb;
        margin-top: 6px;
        overflow: hidden;
    }

    .strength-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.3s, background 0.3s;
        width: 0%;
    }

    @@media (max-width: 900px) {
        .settings-root {
            flex-direction: column;
        }

        .settings-left {
            width: 100%;
            padding: 28px 24px;
        }

        .settings-main {
            padding: 28px 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: 1;
        }
    }
</style>

<div class="settings-root">

    <!-- LEFT: Sidebar -->
    <aside class="settings-left">
        <img src="~/images/circuit.png" class="circuit-bg" alt="" />

        <div class="left-inner">
            <div class="brand-row">
                <img src="~/images/NoBGLogo.png" class="brand-logo" alt="Logo" />
                <span class="brand-name">IT SOLUTIONS</span>
            </div>

            <div class="avatar-circle">
                @if (hasAvatar)
                {
                    <img src="/Account/Avatar/@userId" alt="Avatar" />
                }
                else
                {
                    <span class="avatar-initials">@initials</span>
                }
            </div>

            <p class="left-username">@username</p>

            <nav class="side-nav">
                <a href="/Account/Profile">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    My Profile
                </a>
                <a href="/Account/Settings" class="active">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                    Settings
                </a>
                <a href="/Home/WorkInstruction">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    Dashboard
                </a>
            </nav>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="settings-main">
        <h1 class="page-heading">SETTINGS</h1>
        <p class="page-subheading">Manage your profile, security, and account preferences</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- ── EDIT PROFILE ── -->
        <div class="card">
            <div class="card-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
                <h3>Edit Profile</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/Account/UpdateProfile" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="DisplayName">Display Name</label>
                            <input type="text" id="DisplayName" name="DisplayName"
                                   value="@profileModel.DisplayName"
                                   placeholder="Your display name" />
                        </div>
                        <div class="form-group">
                            <label for="Email">Email Address</label>
                            <div class="input-icon-wrap">
                                <input type="email" id="Email" name="Email"
                                       value="@profileModel.Email"
                                       placeholder="you@example.com" />
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                    <polyline points="22,6 12,13 2,6" />
                                </svg>
                            </div>
                        </div>

                        <div class="form-group full">
                            <label>Profile Picture</label>
                            <div class="avatar-preview-row">
                                <div class="avatar-preview" id="avatarPreviewWrap">
                                    @if (hasAvatar)
                                    {
                                        <img src="/Account/Avatar/@userId" alt="Avatar" />
                                    }
                                    else
                                    {
                                        <span class="avatar-preview-initials">@initials</span>
                                    }
                                </div>
                                <div class="avatar-preview-info">
                                    <span>JPG, PNG, GIF, or WEBP — max 5 MB</span>
                                    <button type="button" onclick="document.getElementById('AvatarFile').click()"
                                            style="display:inline-flex;align-items:center;gap:8px;margin-top:8px;padding:9px 18px;background:#1C3667;color:white;font-family:'Barlow',sans-serif;font-size:13px;font-weight:700;border:none;border-radius:10px;cursor:pointer;transition:background 0.2s;">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;pointer-events:none;">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                            <polyline points="17 8 12 3 7 8" />
                                            <line x1="12" y1="3" x2="12" y2="15" />
                                        </svg>
                                        Upload Photo
                                    </button>
                                    <span id="fileNameLabel" style="font-size:11px;color:#a0b8a8;margin-top:4px;">No file chosen</span>
                                </div>
                            </div>

                            <input type="file" id="AvatarFile" name="AvatarFile"
                                   accept="image/jpeg,image/png,image/gif,image/webp"
                                   onchange="previewAvatar(this)"
                                   style="display:none;" />

                            @if (hasAvatar)
                            {
                                <input type="hidden" name="RemoveAvatar" id="RemoveAvatarInput" value="false" />
                                <button type="button" class="checkbox-row" id="removeAvatarBtn"
                                        style="width:100%; border:1.5px solid #fca5a5; background:#fff5f5; margin-top:12px; cursor:pointer;"
                                        onclick="toggleRemoveAvatar()">
                                    <span id="removeAvatarIcon" style="width:16px;height:16px;border:2px solid #b91c1c;border-radius:3px;flex-shrink:0;display:flex;align-items:center;justify-content:center;"></span>
                                    <span style="font-size:13px;font-weight:600;color:#b91c1c;">Remove current avatar</span>
                                </button>
                            }
                        </div>
                    </div>

                    <button type="submit" class="btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                            <polyline points="17 21 17 13 7 13 7 21" />
                            <polyline points="7 3 7 8 15 8" />
                        </svg>
                        Save Changes
                    </button>
                </form>
            </div>
        </div>

        <!-- ── CHANGE PASSWORD ── -->
        <div class="card">
            <div class="card-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <h3>Change Password</h3>
            </div>
            <div class="card-body">
                <form method="post" asp-action="ChangePassword" asp-controller="Account">
                    @Html.AntiForgeryToken()

                    <div class="form-grid">
                        <div class="form-group full">
                            <label for="CurrentPassword">Current Password</label>
                            <div class="input-icon-wrap">
                                <input type="password" id="CurrentPassword" name="CurrentPassword"
                                       placeholder="Enter current password" />
                                <button type="button" class="toggle-pw" onclick="togglePw('CurrentPassword', this)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="NewPassword">New Password</label>
                            <div class="input-icon-wrap">
                                <input type="password" id="NewPassword" name="NewPassword"
                                       placeholder="At least 6 characters"
                                       oninput="checkStrength(this.value)" />
                                <button type="button" class="toggle-pw" onclick="togglePw('NewPassword', this)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                            <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                            <span class="field-hint" id="strengthLabel"></span>
                        </div>

                        <div class="form-group">
                            <label for="ConfirmPassword">Confirm New Password</label>
                            <div class="input-icon-wrap">
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword"
                                       placeholder="Repeat new password"
                                       oninput="checkMatch()" />
                                <button type="button" class="toggle-pw" onclick="togglePw('ConfirmPassword', this)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                            <span class="field-error" id="matchError" style="display:none;">Passwords do not match.</span>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        Update Password
                    </button>
                </form>
            </div>
        </div>

        <!-- ── DANGER ZONE ── -->
        <div class="danger-zone">
            <div class="card-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
                <h3>Deactivate Account</h3>
            </div>
            <div class="card-body">
                <p class="danger-text">
                    Deactivating your account will sign you out immediately and disable access.
                    Your data will be preserved but you will not be able to log in until an administrator reactivates your account.
                </p>
                <button type="button" class="btn-danger" onclick="document.getElementById('deactivateModal').style.display='flex'">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        <path d="M10 11v6" />
                        <path d="M14 11v6" />
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                    </svg>
                    Deactivate Account
                </button>
            </div>
        </div>
    </main>
</div>

<!-- ── DEACTIVATE MODAL ── -->
<div id="deactivateModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:100; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:18px; padding:36px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.2);">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <div style="width:44px;height:44px;background:#fef2f2;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#b91c1c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
            <div>
                <h3 style="font-family:'Barlow',sans-serif;font-weight:700;font-size:17px;color:#1C3667;margin:0;">Deactivate Account?</h3>
                <p style="font-size:12px;color:#6b7280;margin:2px 0 0 0;">This action cannot be undone by you.</p>
            </div>
        </div>
        <p style="font-size:13px;color:#6b7280;margin:0 0 24px 0;line-height:1.6;">
            You will be immediately signed out and your account will be disabled. Contact an administrator to restore access.
        </p>
        <div style="display:flex;gap:12px;">
            <button type="button"
                    onclick="document.getElementById('deactivateModal').style.display='none'"
                    style="flex:1;padding:11px;font-family:'Barlow',sans-serif;font-size:14px;font-weight:700;background:#f3f4f6;color:#374151;border:none;border-radius:10px;cursor:pointer;">
                Cancel
            </button>
            <form method="post" asp-action="DeactivateAccount" asp-controller="Account" style="flex:1;">
                @Html.AntiForgeryToken()
                <button type="submit"
                        style="width:100%;padding:11px;font-family:'Barlow',sans-serif;font-size:14px;font-weight:700;background:#b91c1c;color:white;border:none;border-radius:10px;cursor:pointer;">
                    Yes, Deactivate
                </button>
            </form>
        </div>
    </div>
</div>


<script>
    function togglePw(fieldId, btn) {
        const input = document.getElementById(fieldId);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';

        const eyeOpen = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
        const eyeOff = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;"><line x1="1" y1="1" x2="23" y2="23"/><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/></svg>`;

        btn.innerHTML = isHidden ? eyeOff : eyeOpen;
    }

    function checkStrength(val) {
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');
        let score = 0;
        if (val.length >= 6) score++;
        if (val.length >= 10) score++;
        if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
            { pct: '20%', color: '#ef4444', text: 'Weak' },
            { pct: '45%', color: '#f97316', text: 'Fair' },
            { pct: '70%', color: '#eab308', text: 'Good' },
            { pct: '100%', color: '#22c55e', text: 'Strong' },
        ];
        const l = levels[Math.max(0, score - 1)] || { pct: '0%', color: '#e5e7eb', text: '' };
        fill.style.width = val.length ? l.pct : '0%';
        fill.style.background = l.color;
        label.textContent = val.length ? l.text : '';
    }

    function checkMatch() {
        const np = document.getElementById('NewPassword').value;
        const cp = document.getElementById('ConfirmPassword').value;
        const err = document.getElementById('matchError');
        err.style.display = (cp && np !== cp) ? 'block' : 'none';
    }

    function previewAvatar(input) {
        if (!input.files || !input.files[0]) return;

        const label = document.getElementById('fileNameLabel');
        if (label) label.textContent = input.files[0].name;

        const reader = new FileReader();
        reader.onload = function (e) {
            const wrap = document.getElementById('avatarPreviewWrap');
            wrap.innerHTML = `<img src="${e.target.result}" alt="Preview" style="width:100%;height:100%;object-fit:cover;" />`;
        };
        reader.readAsDataURL(input.files[0]);
    }

    function handleRemoveAvatar(checkbox) {
        if (checkbox.checked) {
            // Clear file input so it doesn't conflict
            document.getElementById('AvatarFile').value = '';
            // Reset preview to initials
            const wrap = document.getElementById('avatarPreviewWrap');
            wrap.innerHTML = `<span class="avatar-preview-initials">@initials</span>`;
        }
    }

        var removeAvatarChecked = false;

    function toggleRemoveAvatar() {
        removeAvatarChecked = !removeAvatarChecked;
        document.getElementById('RemoveAvatarInput').value = removeAvatarChecked ? 'true' : 'false';

        const icon = document.getElementById('removeAvatarIcon');
        const btn = document.getElementById('removeAvatarBtn');

        if (removeAvatarChecked) {
            icon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" stroke="#b91c1c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6 5 9 10 3"/></svg>`;
            btn.style.background = '#fef2f2';
            btn.style.borderColor = '#b91c1c';
            // Clear file input
            document.getElementById('AvatarFile').value = '';
            document.getElementById('avatarPreviewWrap').innerHTML = `<span class="avatar-preview-initials">@initials</span>`;
        } else {
            icon.innerHTML = '';
            btn.style.background = '#fff5f5';
            btn.style.borderColor = '#fca5a5';
        }
    }
</script>
