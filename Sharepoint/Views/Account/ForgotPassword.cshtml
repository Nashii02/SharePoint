@{
    ViewData["Title"] = "Forgot Password";
}

<script src="https://cdn.tailwindcss.com"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap');

    * {
        box-sizing: border-box;
    }

    body, .forgot-root {
        font-family: 'Barlow', sans-serif;
        min-height: 100vh;
        background: #ECFFEC;
        margin: 0;
    }

    .forgot-root {
        display: flex;
        min-height: 100vh;
    }

    .forgot-left {
        position: relative;
        width: 55%;
        background: #1C3667;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 60px 64px;
        overflow: hidden;
    }

    .circuit-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0) invert(1);
        opacity: 0.08;
        z-index: 0;
    }

    .logo-mask {
        position: absolute;
        right: -5px;
        bottom: 220px;
        width: 420px;
        height: 420px;
        mask-image: url('/images/NoBGLogo.png');
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
        opacity: 0.12;
        z-index: 1;
    }

        .logo-mask img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0) invert(1);
        }

    .logo-ghost {
        position: absolute;
        right: -5px;
        bottom: 220px;
        width: 420px;
        height: 420px;
        object-fit: contain;
        filter: brightness(0) invert(1);
        opacity: 0.08;
        z-index: 2;
    }

    .left-content {
        position: relative;
        z-index: 3;
    }

    .brand-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 56px;
    }

    .brand-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .brand-name {
        font-family: 'Barlow', sans-serif;
        font-weight: 700;
        font-size: 18px;
        color: white;
        letter-spacing: 0.5px;
    }

    .left-headline {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 62px;
        line-height: 1;
        letter-spacing: -1px;
        color: white;
        margin: 0 0 24px 0;
    }

    .left-sub {
        font-size: 15px;
        color: rgba(255,255,255,0.6);
        max-width: 340px;
        line-height: 1.65;
        margin: 0;
    }

    .steps-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 40px;
    }

    .step-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .step-number {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
        border: 1.5px solid rgba(255,255,255,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 12px;
        font-weight: 700;
        color: white;
    }

    .step-text {
        padding-top: 4px;
    }

        .step-text strong {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: rgba(255,255,255,0.85);
            margin-bottom: 2px;
        }

        .step-text span {
            font-size: 12px;
            color: rgba(255,255,255,0.5);
            line-height: 1.5;
        }

    .dot-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 40px;
    }

    .dot-row {
        display: flex;
        gap: 10px;
    }

    .dot {
        width: 7px;
        height: 7px;
        background: rgba(255,255,255,0.45);
        border-radius: 50%;
    }

    .forgot-right {
        width: 45%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 60px 48px;
        background: #ECFFEC;
    }

    .forgot-card {
        width: 100%;
        max-width: 400px;
        background: white;
        border: 1.5px solid #c8e6d4;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(28, 54, 103, 0.08);
    }

    .forgot-card-header {
        background: #1C3667;
        padding: 28px 32px;
    }

        .forgot-card-header h2 {
            font-family: 'Barlow', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: white;
            margin: 0 0 4px 0;
        }

        .forgot-card-header p {
            font-size: 13px;
            color: rgba(255,255,255,0.55);
            margin: 0;
        }

    .forgot-card-body {
        padding: 32px;
    }

    .icon-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #f0f7ff;
        border: 1.5px solid #c8daf4;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 24px;
    }

        .icon-banner svg {
            width: 20px;
            height: 20px;
            color: #1C3667;
            flex-shrink: 0;
        }

        .icon-banner p {
            font-size: 13px;
            color: #3a5a8a;
            margin: 0;
            line-height: 1.5;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #1C3667;
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input {
            width: 100%;
            padding: 11px 14px;
            font-family: 'Barlow', sans-serif;
            font-size: 14px;
            color: #1C3667;
            background: #f7fff7;
            border: 1.5px solid #c8e6d4;
            border-radius: 10px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-group input:focus {
                border-color: #1C3667;
                box-shadow: 0 0 0 3px rgba(28,54,103,0.08);
                background: white;
            }

            .form-group input::placeholder {
                color: #a0b8a8;
            }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap svg.field-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: #a0b8a8;
            pointer-events: none;
        }

    .form-group input.has-icon {
        padding-right: 38px;
    }

    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }

    .btn-submit {
        width: 100%;
        padding: 13px;
        background: #1C3667;
        color: white;
        font-family: 'Barlow', sans-serif;
        font-size: 15px;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        letter-spacing: 0.3px;
        transition: background 0.2s, transform 0.1s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 0;
    }

        .btn-submit:hover {
            background: #162d57;
        }

        .btn-submit:active {
            transform: scale(0.98);
        }

        .btn-submit svg {
            width: 16px;
            height: 16px;
        }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: #c8e6d4;
    }

    .divider span {
        font-size: 12px;
        color: #a0b8a8;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .back-row {
        text-align: center;
    }

        .back-row p {
            font-size: 13px;
            color: #6b8a75;
            margin: 0;
        }

        .back-row a {
            color: #1C3667;
            font-weight: 700;
            text-decoration: none;
        }

            .back-row a:hover {
                text-decoration: underline;
            }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff5f5;
        border: 1.5px solid #fca5a5;
        border-radius: 10px;
        padding: 11px 14px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #b91c1c;
    }

        .error-banner svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    .success-state {
        display: none;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 8px 0 4px;
    }

    .success-icon {
        width: 56px;
        height: 56px;
        background: #f0fdf4;
        border: 2px solid #86efac;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .success-icon svg {
            width: 24px;
            height: 24px;
            color: #16a34a;
        }

    .success-title {
        font-family: 'Barlow', sans-serif;
        font-weight: 700;
        font-size: 17px;
        color: #1C3667;
        margin: 0 0 8px 0;
    }

    .success-sub {
        font-size: 13px;
        color: #6b8a75;
        line-height: 1.6;
        margin: 0 0 24px 0;
    }

    .success-email {
        font-weight: 700;
        color: #1C3667;
    }

    @@media (max-width: 768px) {
        .forgot-root {
            flex-direction: column;
        }

        .forgot-left {
            width: 100%;
            min-height: 220px;
            padding: 36px 32px;
        }

            .forgot-left .left-headline {
                font-size: 42px;
            }

        .forgot-right {
            width: 100%;
            padding: 32px 20px;
        }

        .dot-grid, .steps-list {
            display: none;
        }
    }
</style>

<div class="forgot-root">

    <div class="forgot-left">
        <img src="~/images/circuit.png" class="circuit-bg" alt="" />
        <div class="logo-mask">
            <img src="~/images/circuit.png" alt="" />
        </div>
        <img src="~/images/NoBGLogo.png" class="logo-ghost" alt="" />

        <div class="left-content">
            <div class="brand-row">
                <img src="~/images/NoBGLogo.png" class="brand-logo" alt="Logo" />
                <span class="brand-name">IT SOLUTIONS</span>
            </div>

            <h1 class="left-headline">RESET<br />YOUR<br />PASSWORD</h1>
            <p class="left-sub">We'll help you get back into your account quickly and securely.</p>

            <div class="steps-list">
                <div class="step-item">
                    <div class="step-number">1</div>
                    <div class="step-text">
                        <strong>Enter your email</strong>
                        <span>Provide the email linked to your account</span>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-number">2</div>
                    <div class="step-text">
                        <strong>Check your inbox</strong>
                        <span>We'll send a password reset link</span>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-number">3</div>
                    <div class="step-text">
                        <strong>Set a new password</strong>
                        <span>Follow the link to create a new password</span>
                    </div>
                </div>
            </div>

            <div class="dot-grid">
                <div class="dot-row">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="dot"></div>
                    }
                </div>
                <div class="dot-row">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="dot"></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="forgot-right">
        <div class="forgot-card">
            <div class="forgot-card-header">
                <h2>Forgot your password?</h2>
                <p>Enter your email and we'll send a reset link</p>
            </div>

            <div class="forgot-card-body">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="error-banner">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        @TempData["ErrorMessage"]
                    </div>
                }

                <div id="formState" style="@(ViewBag.ResetEmailSent != null ? "display:none;" : "")">
                    <div class="icon-banner">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <p>Enter the email address associated with your account and we'll send you a link to reset your password.</p>
                    </div>

                    <form method="post" asp-controller="Account" asp-action="ForgotPassword" id="forgotForm">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <div class="input-icon-wrap">
                                <input type="email" id="email" name="email"
                                       class="has-icon"
                                       placeholder="you@company.com"
                                       autocomplete="email"
                                       required />
                                <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                    <polyline points="22,6 12,13 2,6" />
                                </svg>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit" id="submitBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13" />
                                <polygon points="22 2 15 22 11 13 2 9 22 2" />
                            </svg>
                            Send Reset Link
                        </button>
                    </form>
                </div>

                <div class="success-state" id="successState" style="@(ViewBag.ResetEmailSent != null ? "display:flex;" : "")">
                    <div class="success-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>
                    <p class="success-title">Check your inbox</p>
                    <p class="success-sub">
                        We sent a password reset link to<br />
                        <span class="success-email" id="successEmail">@(ViewBag.ResetEmailSent ?? "")</span>
                    </p>
                    <button type="button" class="btn-submit" onclick="resendEmail()" id="resendBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1 4 1 10 7 10" />
                            <path d="M3.51 15a9 9 0 1 0 .49-4" />
                        </svg>
                        Resend Email
                    </button>
                </div>

                <div class="divider">
                    <div class="divider-line"></div>
                    <span>or</span>
                    <div class="divider-line"></div>
                </div>

                <div class="back-row">
                    <p>Remembered your password? <a href="/Account/Login">Sign in</a></p>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('forgotForm')?.addEventListener('submit', function () {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin" style="width:16px;height:16px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Sending…`;
    });

    function resendEmail() {
        const btn = document.getElementById('resendBtn');
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin" style="width:16px;height:16px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Sending…`;
        setTimeout(() => {
            btn.disabled = false;
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4"/></svg> Resend Email`;
        }, 2000);
    }
</script>