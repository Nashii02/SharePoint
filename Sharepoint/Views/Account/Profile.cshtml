@model Sharepoint.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<script src="https://cdn.tailwindcss.com"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap');

    *, *::before, *::after { box-sizing: border-box; }

    body, .profile-root {
        font-family: 'Barlow', sans-serif;
        min-height: 100vh;
        background: #ECFFEC;
        margin: 0;
    }

    .profile-root {
        display: flex;
        min-height: 100vh;
    }

    /* ── LEFT PANEL ── */
    .profile-left {
        position: relative;
        width: 300px;
        min-width: 260px;
        background: #1C3667;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 48px 32px 40px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .circuit-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0) invert(1);
        opacity: 0.06;
        z-index: 0;
    }

    .left-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    /* Brand */
    .brand-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 48px;
        align-self: flex-start;
    }
    .brand-logo {
        width: 36px;
        height: 36px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }
    .brand-name {
        font-weight: 700;
        font-size: 14px;
        color: white;
        letter-spacing: 0.5px;
    }

    /* Avatar */
    .avatar-wrap {
        position: relative;
        width: 110px;
        height: 110px;
        margin-bottom: 20px;
    }

    .avatar-circle {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: #DDF0DD; /* ← matches navbar exactly */
        border: 3px solid rgba(255,255,255,0.25);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-initials {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 42px;
        color: #1C3667; /* ← matches navbar exactly */
        letter-spacing: -1px;
    }   

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.85);
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .left-username {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 26px;
        color: white;
        letter-spacing: -0.5px;
        text-align: center;
        margin: 0 0 4px 0;
    }

    .left-email {
        font-size: 12px;
        color: rgba(255,255,255,0.5);
        text-align: center;
        margin: 0 0 36px 0;
        word-break: break-all;
    }

    /* Stats */
    .stats-box {
        width: 100%;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 14px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 32px;
    }

    .stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .stat-label {
        font-size: 12px;
        color: rgba(255,255,255,0.5);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 14px;
        font-weight: 700;
        color: white;
    }

    .stat-divider {
        height: 1px;
        background: rgba(255,255,255,0.08);
    }

    /* Nav links */
    .side-nav {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .side-nav a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        color: rgba(255,255,255,0.65);
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
    }

    .side-nav a:hover, .side-nav a.active {
        background: rgba(255,255,255,0.1);
        color: white;
    }

    .side-nav a svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
    }

    /* ── MAIN CONTENT ── */
    .profile-main {
        flex: 1;
        padding: 48px 48px 48px 40px;
        overflow-y: auto;
    }

    .page-heading {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 42px;
        color: #1C3667;
        letter-spacing: -1px;
        margin: 0 0 4px 0;
        line-height: 1;
    }

    .page-subheading {
        font-size: 14px;
        color: #6b8a75;
        margin: 0 0 32px 0;
    }

    /* Cards */
    .card {
        background: white;
        border: 1.5px solid #c8e6d4;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 16px rgba(28,54,103,0.06);
        margin-bottom: 24px;
    }

    .card-header {
        background: #1C3667;
        padding: 20px 28px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .card-header svg {
        width: 18px;
        height: 18px;
        color: rgba(255,255,255,0.7);
        flex-shrink: 0;
    }

    .card-header h3 {
        font-family: 'Barlow', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: white;
        margin: 0;
    }

    .card-body {
        padding: 28px;
    }

    /* Info grid */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .info-item.full {
        grid-column: 1 / -1;
    }

    .info-label {
        font-size: 11px;
        font-weight: 700;
        color: #a0b8a8;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .info-value {
        font-size: 15px;
        font-weight: 600;
        color: #1C3667;
    }

    .info-value.muted {
        color: #a0b8a8;
        font-style: italic;
        font-weight: 400;
    }

    /* Upload count card */
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 16px;
    }

    .metric-card {
        background: #f7fff7;
        border: 1.5px solid #c8e6d4;
        border-radius: 14px;
        padding: 20px 20px 18px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .metric-icon {
        width: 36px;
        height: 36px;
        background: #1C3667;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 6px;
    }

    .metric-icon svg {
        width: 18px;
        height: 18px;
        color: white;
    }

    .metric-number {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 36px;
        color: #1C3667;
        line-height: 1;
    }

    .metric-label {
        font-size: 12px;
        font-weight: 600;
        color: #6b8a75;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* CTA buttons */
    .action-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: #1C3667;
        color: white;
        font-family: 'Barlow', sans-serif;
        font-size: 14px;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s, transform 0.1s;
    }

    .btn-primary:hover { background: #162d57; }
    .btn-primary:active { transform: scale(0.98); }

    .btn-primary svg {
        width: 15px;
        height: 15px;
    }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: transparent;
        color: #1C3667;
        font-family: 'Barlow', sans-serif;
        font-size: 14px;
        font-weight: 700;
        border: 1.5px solid #c8e6d4;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
        transition: border-color 0.2s, background 0.2s, transform 0.1s;
    }

    .btn-outline:hover { border-color: #1C3667; background: #f7fff7; }
    .btn-outline:active { transform: scale(0.98); }

    .btn-outline svg {
        width: 15px;
        height: 15px;
    }

    @@media (max-width: 900px) {
        .profile-root { flex-direction: column; }
        .profile-left { width: 100%; min-height: auto; padding: 32px 24px; flex-direction: row; flex-wrap: wrap; gap: 20px; }
        .left-inner { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 20px; }
        .brand-row { margin-bottom: 0; }
        .avatar-wrap { width: 72px; height: 72px; margin-bottom: 0; }
        .avatar-circle { width: 72px; height: 72px; }
        .avatar-initials { font-size: 28px; }
        .stats-box { display: none; }
        .profile-main { padding: 32px 24px; }
        .info-grid { grid-template-columns: 1fr; }
    }
</style>

@{
    string initials = string.IsNullOrWhiteSpace(Model.DisplayName)
        ? Model.Username.Substring(0, Math.Min(2, Model.Username.Length)).ToUpper()
        : string.Join("", Model.DisplayName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
}

<div class="profile-root">

    <!-- LEFT: Sidebar -->
    <aside class="profile-left">
        <img src="~/images/circuit.png" class="circuit-bg" alt="" />

        <div class="left-inner">
            <div class="brand-row">
                <img src="~/images/NoBGLogo.png" class="brand-logo" alt="Logo" />
                <span class="brand-name">IT SOLUTIONS</span>
            </div>

            <div class="avatar-wrap">
                <div class="avatar-circle">
                    @if (Model.HasAvatar)
                    {
                        <img src="/Account/Avatar/@Model.Id" alt="Avatar" />
                    }
                    else
                    {
                        <span class="avatar-initials">
                            @(Model.Username.Length >= 2 ? Model.Username.Substring(0, 2).ToUpper() : Model.Username.ToUpper())
                        </span>
                    }
                </div>
            </div>

            <span class="role-badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px;">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                @Model.Role
            </span>

            <h2 class="left-username">@(Model.DisplayName ?? Model.Username)</h2>
            <p class="left-email">@(Model.Email ?? "No email set")</p>

            <div class="stats-box">
                <div class="stat-row">
                    <span class="stat-label">Username</span>
                    <span class="stat-value">@Model.Username</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-row">
                    <span class="stat-label">Member Since</span>
                    <span class="stat-value">@Model.CreatedAt.ToString("MMM yyyy")</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-row">
                    <span class="stat-label">Uploads</span>
                    <span class="stat-value">@Model.UploadCount</span>
                </div>
            </div>

            <nav class="side-nav">
                <a href="/Account/Profile" class="active">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                    My Profile
                </a>
                <a href="/Account/Settings">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    Settings
                </a>
                <a href="/Home/WorkInstruction">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Dashboard
                </a>
            </nav>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="profile-main">
        <h1 class="page-heading">MY PROFILE</h1>
        <p class="page-subheading">Your account information and activity overview</p>

        <!-- Account Details -->
        <div class="card">
            <div class="card-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
                <h3>Account Details</h3>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Display Name</span>
                        <span class="info-value">@(Model.DisplayName ?? Model.Username)</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Username</span>
                        <span class="info-value">@Model.Username</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Email Address</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <span class="info-value">@Model.Email</span>
                        }
                        else
                        {
                            <span class="info-value muted">Not set</span>
                        }
                    </div>
                    <div class="info-item">
                        <span class="info-label">Role</span>
                        <span class="info-value">@Model.Role</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Member Since</span>
                        <span class="info-value">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity -->
        <div class="card">
            <div class="card-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                </svg>
                <h3>Activity Overview</h3>
            </div>
            <div class="card-body">
                <div class="metric-grid">
                    <div class="metric-card">
                        <div class="metric-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                            </svg>
                        </div>
                        <span class="metric-number">@Model.UploadCount</span>
                        <span class="metric-label">Documents</span>
                    </div>
                    <div class="metric-card">
                        <div class="metric-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <span class="metric-number">@((int)(DateTime.UtcNow - Model.CreatedAt).TotalDays)</span>
                        <span class="metric-label">Days Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="card">
            <div class="card-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                <h3>Quick Actions</h3>
            </div>
            <div class="card-body">
                <div class="action-row">
                    <a href="/Account/Settings" class="btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        Edit Profile
                    </a>
                    <a href="/Home/WorkInstruction" class="btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </main>
</div>
