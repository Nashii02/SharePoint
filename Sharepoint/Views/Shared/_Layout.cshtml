@using Sharepoint.Data
@inject AppDbContext _db

@{
    bool hasAvatar = false;
    int userId = 0;

    if (User.Identity?.IsAuthenticated == true)
    {
        var username = User.Identity.Name;

        var currentUser = _db.Users
            .FirstOrDefault(u => u.Username == username);

        if (currentUser != null)
        {
            hasAvatar = currentUser.AvatarData != null;
            userId = currentUser.Id;
        }
    }
}

@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var breadcrumbs = new List<(string Label, string? Url)>();

    if (currentController == "Home" && currentAction == "WorkInstruction")
    {
        breadcrumbs.Add(("Work Instructions", null));
    }
    else if (currentController == "WorkInstructions")
    {
        breadcrumbs.Add(("Work Instructions", "/Home/WorkInstruction"));

        if (currentAction == "Upload")
        {
            // Use ViewBag.CategoryName set by the controller — works for ALL categories including custom ones
            var categoryName = ViewBag.CategoryName as string ?? "Upload";
            breadcrumbs.Add((categoryName, null));
        }
        else if (currentAction != null)
        {
            breadcrumbs.Add((currentAction, null));
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sharepoint</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sharepoint.styles.css" asp-append-version="true" />

    <style>
        html, body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            width: 100%;
        }

        #globalSearch,
        #globalSearch + *,
        .hidden.md\:flex {
            display: none !important;
        }

        .dropdown-menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
        }

            .dropdown-menu-item:hover {
                background: #ddf0dd;
            }

        .dropdown-divider {
            border-top: 1px solid #ddf0dd;
            margin: 4px 0;
        }
    </style>
</head>
<body>

    <header>
        <!-- NAVBAR -->
        <nav class="bg-[#1C3667] text-white shadow-md" style="position: relative; z-index: 1;">
            <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-between">
                <img src="~/images/circuit.png"
                     class="absolute inset-0 w-full h-full filter brightness-0 invert opacity-10 pointer-events-none"
                     style="z-index: 0; object-fit: cover; object-position: center top;" />
                <a href="/Home/WorkInstruction" class="flex items-center gap-3">
                    <img src="~/images/ITLogo.png" width="35" height="35" />
                    <h1 class="text-sm font-bold text-white">IT SOLUTIONS</h1>
                </a>

                <!-- Right side: Apps + Profile -->
                <div class="flex items-center gap-2">
                    <button id="appsBtn" title="Microsoft 365 apps" aria-label="Microsoft 365 apps"
                            class="flex items-center justify-center w-9 h-9 rounded-full border border-white/30 text-white hover:bg-white/15 transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1" />
                            <rect x="14" y="3" width="7" height="7" rx="1" />
                            <rect x="3" y="14" width="7" height="7" rx="1" />
                            <rect x="14" y="14" width="7" height="7" rx="1" />
                        </svg>
                    </button>
                    <!-- Profile avatar -->
                    <button id="profileBtn" title="Account"
                            class="w-9 h-9 rounded-full overflow-hidden bg-[#DDF0DD] text-[#1C3667] text-xs font-bold flex items-center justify-center border border-white/30 hover:opacity-85 transition-opacity cursor-pointer">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (hasAvatar)
                            {
                                <img src="/Account/Avatar/@userId"
                                     alt="Avatar"
                                     class="w-full h-full object-cover" />
                            }
                            else
                            {
                                @(User.Identity.Name?.Length > 0
                                                        ? User.Identity.Name.Substring(0, 2).ToUpper()
                                                        : "?")
                                                }
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1C3667" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        }
                    </button>
                </div>
            </div>
        </nav>

        <!-- MENU + BREADCRUMB -->
        <div class="bg-[#DDF0DD] py-3 shadow-sm">
            <div class="max-w-7xl mx-auto flex items-center justify-between px-4">

                <!-- BREADCRUMB -->
                <nav class="flex items-center gap-1" aria-label="Breadcrumb">
                    <button id="backBtn" onclick="handleBack()" title="Go back"
                            class="flex items-center justify-center w-8 h-8 rounded-full border border-[#C5DFC5] bg-[#C5DFC5] text-[#1C3667] hover:bg-[#1C3667] hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                    </button>

                    <button id="forwardBtn" onclick="handleForward()" title="Go forward"
                            class="hidden items-center justify-center w-8 h-8 rounded-full border border-[#C5DFC5] bg-[#C5DFC5] text-[#1C3667] hover:bg-[#1C3667] hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </button>

                    <button id="refreshBtn" onclick="location.reload()" title="Refresh page"
                            class="flex items-center justify-center w-8 h-8 rounded-full border border-[#C5DFC5] bg-[#C5DFC5] text-[#1C3667] hover:bg-[#1C3667] hover:text-white transition-colors mr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                            <polyline points="23 4 23 10 17 10" />
                            <polyline points="1 20 1 14 7 14" />
                            <path d="M3.51 9a9 9 0 0 1 14.36-3.36L23 10M1 14l5.13 4.36A9 9 0 0 0 20.49 15" />
                        </svg>
                    </button>

                    <div class="flex items-center gap-1 pl-20">
                        @for (int i = 0; i < breadcrumbs.Count; i++)
                        {
                            var crumb = breadcrumbs[i];
                            bool isLast = i == breadcrumbs.Count - 1;

                            if (isLast)
                            {
                                <span class="px-3 py-2 rounded-md font-bold text-sm bg-[#1C3667] text-white">
                                    @crumb.Label
                                </span>
                            }
                            else
                            {
                                <a href="@crumb.Url"
                                   onclick="registerNavigation()"
                                   class="px-3 py-2 rounded-md font-bold text-sm hover:bg-[#1C3667] hover:!text-white transition" style="color:#1C3667;">
                                    @crumb.Label
                                </a>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                     stroke-linejoin="round" class="w-3 h-3 text-[#1C3667] opacity-40 flex-shrink-0">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            }
                        }
                    </div>
                </nav>

                <!-- SEARCH BAR -->
                <div class="hidden md:flex items-center bg-[#1C3667] rounded-lg px-3 py-2 w-80">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#DDF0DD]"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" id="globalSearch" placeholder="Search..."
                           class="w-full outline-none bg-[#1C3667] px-2 text-white placeholder-white/50" />
                </div>
            </div>
        </div>
    </header>

    <!-- DROPDOWNS — rendered at body level to avoid clipping -->
    <!-- Apps dropdown -->
    <div id="appsDropdown"
         style="display:none; position:fixed; background:white; border-radius:12px; border:1px solid #e5e7eb; width:256px; z-index:99999; box-shadow:0 4px 20px rgba(0,0,0,0.15);">
        <div style="padding:12px 16px; border-bottom:1px solid #f3f4f6; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.05em;">
            Microsoft 365
        </div>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:4px; padding:12px;">
            <a href="https://www.office.com/launch/word" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-word-2019.png" width="36" height="36" alt="Word" />
                <span style="font-size:11px;font-weight:500;color:#374151;">Word</span>
            </a>
            <a href="https://www.office.com/launch/excel" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-excel-2019.png" width="36" height="36" alt="Excel" />
                <span style="font-size:11px;font-weight:500;color:#374151;">Excel</span>
            </a>
            <a href="https://www.office.com/launch/powerpoint" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-powerpoint-2019.png" width="36" height="36" alt="PowerPoint" />
                <span style="font-size:11px;font-weight:500;color:#374151;">PowerPoint</span>
            </a>
            <a href="https://outlook.office.com/mail" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-outlook-2019.png" width="36" height="36" alt="Outlook" />
                <span style="font-size:11px;font-weight:500;color:#374151;">Outlook</span>
            </a>
            <a href="https://teams.microsoft.com" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-teams.png" width="36" height="36" alt="Teams" />
                <span style="font-size:11px;font-weight:500;color:#374151;">Teams</span>
            </a>
            <a href="https://www.office.com/launch/sharepoint" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-sharepoint-2019.png" width="36" height="36" alt="SharePoint" />
                <span style="font-size:11px;font-weight:500;color:#374151;">SharePoint</span>
            </a>
            <a href="https://onedrive.live.com" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-onedrive-2019.png" width="36" height="36" alt="OneDrive" />
                <span style="font-size:11px;font-weight:500;color:#374151;">OneDrive</span>
            </a>
            <a href="https://www.onenote.com/notebooks" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <img src="https://img.icons8.com/color/48/microsoft-onenote-2019.png" width="36" height="36" alt="OneNote" />
                <span style="font-size:11px;font-weight:500;color:#374151;">OneNote</span>
            </a>
            <a href="https://www.office.com/apps" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px;border-radius:8px;text-decoration:none;color:inherit;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='transparent'">
                <div style="width:36px;height:36px;border-radius:6px;background:#1C3667;display:flex;align-items:center;justify-content:center;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                </div>
                <span style="font-size:11px;font-weight:500;color:#374151;">All apps</span>
            </a>
        </div>
    </div>

    <!-- Profile dropdown -->
    <div id="profileDropdown"
         style="display:none; position:fixed; background:white; border-radius:12px; border:1px solid #e5e7eb; width:240px; z-index:99999; box-shadow:0 4px 20px rgba(0,0,0,0.15); overflow: hidden;">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <!-- Logged in header -->
            <div style="padding:12px 16px; border-bottom:1px solid #f3f4f6; display:flex; align-items:center; gap:12px; background: #1c3667">
                <div style="width:40px;height:40px;border-radius:50%;background:#DDF0DD;color:#1C3667;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;">
                    @if (hasAvatar)
                    {
                        <img src="/Account/Avatar/@userId"
                             alt="Avatar"
                             style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        @(User.Identity.Name?.Length > 0
                                        ? User.Identity.Name.Substring(0, 2).ToUpper()
                                        : "?")
                                }
                </div>
                <div style="min-width:0;">
                    <p style="margin:0;font-size:13px;font-weight:600;color:white;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@User.Identity.Name</p>
                    <p style="margin:2px 0 0; font-weight:500; font-size:11px;color:white;">Logged in</p>
                </div>
            </div>
            <div style="padding:4px 0;">
                <a href="/Home/WorkInstruction" class="dropdown-menu-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;font-size:13px;color:#374151;text-decoration:none;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1C3667" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    Home
                </a>
                <a href="/Account/Profile" class="dropdown-menu-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;font-size:13px;color:#374151;text-decoration:none;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1C3667" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    View profile
                </a>
                <a href="/Account/Settings" class="dropdown-menu-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;font-size:13px;color:#374151;text-decoration:none;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1C3667" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    Settings
