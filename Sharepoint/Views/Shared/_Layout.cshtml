                <hr style="border:none;border-top:1px solid #f3f4f6;margin:4px 0;" />
                <form method="post" action="/Account/Logout" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-menu-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;font-size:13px;color:#dc2626;border:none;width:100%;cursor:pointer;border-radius:8px;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Sign out
                    </button>
                </form>
            </div>
        }
        else
        {
            <!-- Anonymous header -->
            <div style="padding:16px; border-bottom:1px solid #f3f4f6; text-align:center;">
                <div style="width:48px;height:48px;border-radius:50%;background:#f3f4f6;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                </div>
                <p style="margin:0;font-size:13px;font-weight:600;color:#1C3667;">Browsing anonymously</p>
                <p style="margin:4px 0 0;font-size:11px;color:#9ca3af;">Sign in to upload files</p>
            </div>
            <div style="padding:12px 16px;">
                <a href="/Account/Login" style="display:block;text-align:center;padding:9px;background:#1C3667;color:white;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;" onmouseover="this.style.background='#16305a'" onmouseout="this.style.background='#1C3667'">
                    Sign in
                </a>
                <a href="/Account/Register" style="display:block;text-align:center;padding:9px;margin-top:6px;border:1px solid #e5e7eb;color:#374151;border-radius:8px;font-size:13px;font-weight:500;text-decoration:none;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='transparent'">
                    Create account
                </a>
            </div>
        }
    </div>

    <div style="padding:0; margin:0; width:100%;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted relative overflow-hidden" style="background:#1C3667;">
        <!-- Circuit background -->
        <img src="~/images/circuit.png"
             class="absolute inset-0 w-full h-full filter brightness-0 invert opacity-10 pointer-events-none"
             style="z-index: 0; object-fit: cover; object-position: center top;" />

        <a href="/Home/WorkInstruction" class="flex items-center gap-3 translate-x-5 relative" style="z-index: 1;">
            <img src="~/images/ITLogo.png" width="35" height="35" />
            <center><h1 class="text-sm font-bold text-white">IT SOLUTIONS</h1></center>
        </a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


<script>
    const backBtn = document.getElementById('backBtn');
    const forwardBtn = document.getElementById('forwardBtn');

    function updateButtons() {
        const stack = parseInt(sessionStorage.getItem('historyStack') || '0');
        const forward = parseInt(sessionStorage.getItem('forwardStack') || '0');
        backBtn.style.opacity = stack <= 0 ? '0.35' : '1';
        backBtn.style.pointerEvents = stack <= 0 ? 'none' : 'auto';
        if (forward > 0) {
            forwardBtn.classList.remove('hidden');
            forwardBtn.classList.add('flex');
        } else {
            forwardBtn.classList.add('hidden');
            forwardBtn.classList.remove('flex');
        }
    }

    function handleBack() {
        let stack = parseInt(sessionStorage.getItem('historyStack') || '0');
        let forward = parseInt(sessionStorage.getItem('forwardStack') || '0');
        if (stack <= 0) return;
        stack--; forward++;
        sessionStorage.setItem('historyStack', stack.toString());
        sessionStorage.setItem('forwardStack', forward.toString());
        updateButtons();
        history.back();
    }

    function handleForward() {
        let stack = parseInt(sessionStorage.getItem('historyStack') || '0');
        let forward = parseInt(sessionStorage.getItem('forwardStack') || '0');
        if (forward <= 0) return;
        stack++; forward--;
        sessionStorage.setItem('historyStack', stack.toString());
        sessionStorage.setItem('forwardStack', forward.toString());
        updateButtons();
        history.forward();
    }

    function registerNavigation() {
        let stack = parseInt(sessionStorage.getItem('historyStack') || '0');
        stack++;
        sessionStorage.setItem('historyStack', stack.toString());
        sessionStorage.setItem('forwardStack', '0');
        sessionStorage.setItem('_manualNav', '1');
        updateButtons();
    }

    // Detect how we arrived at this page
    (function () {
        const navEntry = performance.getEntriesByType('navigation')[0];
        const navType = navEntry ? navEntry.type : 'navigate';

        if (navType === 'back_forward') {
            // Stacks already updated in handleBack/handleForward before history.back/forward() was called
        } else if (navType === 'navigate') {
            if (!sessionStorage.getItem('_manualNav')) {
                if (document.referrer) {
                    let stack = parseInt(sessionStorage.getItem('historyStack') || '0');
                    stack++;
                    sessionStorage.setItem('historyStack', stack.toString());
                    sessionStorage.setItem('forwardStack', '0');
                }
            }
        }
        sessionStorage.removeItem('_manualNav');
        updateButtons();
    })();

    // ── Dropdowns ──────────────────────────────────────────────────────────

    function positionDropdown(dropdown, anchorBtn) {
        const rect = anchorBtn.getBoundingClientRect();
        const dropW = dropdown.offsetWidth;
        let left = rect.right - dropW;
        let top = rect.bottom + 8;
        if (left < 8) left = 8;
        dropdown.style.top = top + 'px';
        dropdown.style.left = left + 'px';
    }

    const appsDropdown = document.getElementById('appsDropdown');
    const profileDropdown = document.getElementById('profileDropdown');
    const appsBtn = document.getElementById('appsBtn');
    const profileBtn = document.getElementById('profileBtn');

    appsBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        profileDropdown.style.display = 'none';
        if (appsDropdown.style.display === 'none' || appsDropdown.style.display === '') {
            appsDropdown.style.display = 'block';
            positionDropdown(appsDropdown, appsBtn);
        } else {
            appsDropdown.style.display = 'none';
        }
    });

    profileBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        appsDropdown.style.display = 'none';
        if (profileDropdown.style.display === 'none' || profileDropdown.style.display === '') {
            profileDropdown.style.display = 'block';
            positionDropdown(profileDropdown, profileBtn);
        } else {
            profileDropdown.style.display = 'none';
        }
    });

    document.addEventListener('click', function () {
        appsDropdown.style.display = 'none';
        profileDropdown.style.display = 'none';
    });

    window.addEventListener('resize', function () {
        if (appsDropdown.style.display === 'block') positionDropdown(appsDropdown, appsBtn);
        if (profileDropdown.style.display === 'block') positionDropdown(profileDropdown, profileBtn);
    });
</script>