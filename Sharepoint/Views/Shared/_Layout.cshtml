

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sharepoint</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sharepoint.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        
        
    </header>
    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-[#1C3667]">
        <div class="container pl-20">
            <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-between">

                <!-- LOGO + TITLE -->
                <div class="flex items-center gap-3">
                    <img src="~/images/ITLogo.png" width="32" height="32" />

                    <h1 class="text-xs font-bold text-white">
                        IT SOLUTIONS
                    </h1>
                </div>

            </div>
            
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
