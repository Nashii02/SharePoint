@model ModulePageViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = Model.ModuleTitle;
    Layout = null;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        font-family: 'DM Sans', sans-serif;
    }

    /* Dot grid texture for hero */
    .hero-texture {
        background-image: radial-gradient(circle, rgba(255,255,255,0.12) 1px, transparent 1px);
        background-size: 22px 22px;
    }

    /* Dropzone drag-over state */
    .dropzone-active {
        border-color: #1B2A6B !important;
        background-color: #EEF2FF !important;
    }

    /* File row hover accent */
    .file-row:hover .file-actions {
        opacity: 1;
    }

    .file-actions {
        opacity: 0;
        transition: opacity 0.15s;
    }

    /* Action button pill */
    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        transition: background 0.15s, color 0.15s;
        color: #9ca3af;
    }

        .action-btn:hover {
            background: #EEF2FF;
            color: #1B2A6B;
        }

        .action-btn.danger:hover {
            background: #FEF2F2;
            color: #f87171;
        }

    /* Upload button states */
    #upload-btn:not(:disabled) {
        cursor: pointer;
    }

    #upload-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Subtle card border */
    .card {
        border: 1px solid #E8EAF0;
    }

    /* Version history indent */
    .version-row {
        border-left: 3px solid #E8EAF0;
    }

    /* Focus rings */
    textarea:focus, input:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(27,42,107,0.18);
    }

    /* Scrollbar thin */
    ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }
</style>

<div class="min-h-screen flex flex-col bg-[#FFFFFF]">

    <!-- HERO -->
    <section class="bg-[#1B2A6B] text-white relative overflow-hidden"
             style="box-shadow: 0 4px 24px rgba(27,42,107,0.18);">

        <!-- Dot texture overlay -->
        <div class="hero-texture absolute inset-0 pointer-events-none"></div>

        <!-- Faint diagonal accent -->
        <div class="absolute -right-16 -top-16 w-72 h-72 rounded-full opacity-5"
             style="background: radial-gradient(circle, #ffffff 0%, transparent 70%);"></div>

        <div class="relative max-w-7xl mx-auto px-8 py-8">

            <!-- Breadcrumb -->
            <nav class="mb-4 inline-flex items-center gap-2 text-xs">
                <a href="/Home/WorkInstruction"
                   class="text-blue-300 hover:text-white transition flex items-center gap-1.5"> 
                    Work Instructions
                </a>
                <i class="fa-solid fa-chevron-right text-[8px] text-blue-400/60"></i>
                <span class="text-white/80 font-medium">@Model.ModuleTitle</span>
            </nav>

            <!-- Title row -->
            <div class="flex items-end justify-between gap-6 flex-wrap">

                <div>
                    <h1 class="text-4xl font-bold tracking-tight leading-none">
                        @Model.ModuleTitle.ToUpper()
                    </h1>
                    <p class="text-blue-200/80 text-sm mt-2">@Model.ModuleSubtitle</p>
                </div>

                <!-- Module stat pills — in the hero -->
                <div class="flex items-center gap-3 pb-1 flex-wrap">

                    <div class="flex items-center gap-2 bg-white/10 backdrop-blur rounded-lg px-3 py-2 border border-white/10">
                        <div class="w-7 h-7 rounded-md bg-white/15 flex items-center justify-center">
                            <i class="fa-solid fa-file text-white text-xs"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-blue-200/70 leading-none">Total Files</p>
                            <p class="text-sm font-bold text-white leading-tight mt-0.5">@Model.Files.Count</p>
                        </div>
                    </div>


                    @if (Model.Files.Any())
                    {
                        var latestFile = Model.Files.OrderByDescending(f => f.UploadedDate).FirstOrDefault();
                        <div class="flex items-center gap-2 bg-white/10 backdrop-blur rounded-lg px-3 py-2 border border-white/10">
                            <div class="w-7 h-7 rounded-md bg-white/15 flex items-center justify-center">
                                <i class="fa-solid fa-clock-rotate-left text-white text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] text-blue-200/70 leading-none">Last Upload</p>
                                <p class="text-sm font-bold text-white leading-tight mt-0.5">
                                    @latestFile?.UploadedDateFormatted
                                </p>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </section>

    <!-- BODY -->
    <div class="flex-1 py-7">
        <div class="max-w-7xl mx-auto px-8">
            <div class="@(User.IsInRole("Admin") || User.IsInRole("User") ? "flex gap-6 items-start" : "")">

                <!-- LEFT: FILE LIST -->
                <div class="flex-1 bg-white rounded-xl card shadow-sm overflow-hidden flex flex-col">

                    <!-- Panel header -->
                    <div class="px-5 py-3.5 flex items-center justify-between"
                         style="border-bottom: 1px solid #F0F1F5; border-top: 3px solid #1B2A6B;">

                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-folder-open text-[#1B2A6B] text-sm"></i>
                            <p class="text-sm font-semibold text-[#1B2A6B]">Files</p>
                        </div>

                        <div class="flex items-center gap-3">

                            <!-- Search — hidden when no files -->
                            @if (Model.Files.Any())
                            {
                                <div class="flex items-center bg-[#F5F6FA] rounded-lg px-3 py-1.5 gap-2"
                                     style="border: 1px solid #E8EAF0;">
                                    <i class="fa-solid fa-magnifying-glass text-gray-300 text-xs"></i>
                                    <input type="text"
                                           id="file-search"
                                           placeholder="Search files..."
                                           oninput="searchFiles(this.value)"
                                           class="text-xs bg-transparent w-36 text-gray-600" />
                                </div>
                            }

                            <!-- Count pill -->
                            <span id="file-count"
                                  class="text-[10px] font-semibold bg-[#EEF2FF] text-[#1B2A6B] px-2.5 py-1 rounded-full">
                                @Model.Files.Count file(s)
                            </span>
                        </div>
                    </div>

                    <div class="flex-1 overflow-y-auto" style="min-height: 0;">

                    @if (Model.Files.Any())
                        {
                            var fileGroups = Model.Files
                                .GroupBy(f => f.OriginalFileName ?? f.FileName)
                                .Select(g => new {
                                    Latest  = g.OrderByDescending(f => f.Version).First(),
                                    History = g.OrderByDescending(f => f.Version).Skip(1).ToList()
                                }).ToList();

                            <div id="no-files-found" style="display:none;"
                                 class="px-5 py-10 text-center text-gray-400 text-sm">
                                <i class="fa-solid fa-magnifying-glass text-3xl mb-3 block text-gray-200"></i>
                                No files match your search.
                            </div>

                            <ul id="file-list" class="divide-y divide-gray-50">
                            @foreach (var group in fileGroups)
                            {
                                var file = group.Latest;
                                var (iconClass, iconColor, iconBg) = file.FileType.ToLower() switch
                                {
                                    "pdf" => ("fa-solid fa-file-pdf", "text-red-500", "bg-red-50"),
                                    "docx" => ("fa-solid fa-file-word", "text-blue-500", "bg-blue-50"),
                                    "doc" => ("fa-solid fa-file-word", "text-blue-500", "bg-blue-50"),
                                    "xlsx" => ("fa-solid fa-file-excel", "text-emerald-500", "bg-emerald-50"),
                                    "xls" => ("fa-solid fa-file-excel", "text-emerald-500", "bg-emerald-50"),
                                    "pptx" => ("fa-solid fa-file-powerpoint", "text-orange-500", "bg-orange-50"),
                                    _ => ("fa-solid fa-file", "text-gray-400", "bg-gray-50")
                                };

                                <li data-filename="@file.FileName.ToLower() @file.FileType.ToLower() @file.Description?.ToLower()">

                                    <!-- Latest version row -->
                                    <div class="file-row flex items-center gap-4 px-5 py-3.5 hover:bg-[#F8F9FF] transition group">

                                        <!-- File type icon -->
                                        <div class="w-10 h-10 rounded-lg @iconBg flex items-center justify-center flex-shrink-0">
                                            <i class="@iconClass @iconColor text-base"></i>
                                        </div>

                                        <!-- File info -->
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <p class="text-sm font-semibold text-[#1B2A6B] truncate">
                                                    @(file.OriginalFileName ?? file.FileName)
                                                </p>
                                                @if (file.Version > 1)
                                                {
                                                    <span class="text-[9px] font-bold bg-[#EEF2FF] text-[#1B2A6B] px-1.5 py-0.5 rounded">
                                                        Newer Version
                                                    </span>
                                                }
                                                @if (group.History.Any())
                                                {
                                                    <button type="button"
                                                            onclick="toggleHistory('history-@file.Id')"
                                                            class="text-[9px] text-[#1B2A6B]/50 hover:text-[#1B2A6B] underline underline-offset-2 flex-shrink-0 transition">
                                                        @group.History.Count older version(s)
                                                    </button>
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(file.Description))
                                            {
                                                <p class="text-[11px] text-gray-400 mt-0.5 truncate">@file.Description</p>
                                            }

                                            <div class="flex items-center gap-3 mt-1 flex-wrap">
                                                
                                                <span class="text-[10px] text-gray-400 flex items-center gap-1">
                                                    <i class="fa-solid fa-calendar text-[8px]"></i>@file.UploadedDateFormatted
                                                </span>
                                                @if (!string.IsNullOrEmpty(file.FileSize))
                                                {
                                                    <span class="text-[10px] text-gray-400 flex items-center gap-1">
                                                        <i class="fa-solid fa-database text-[8px]"></i>@file.FileSize
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Type badge -->
                                        <span class="text-[9px] font-bold uppercase px-2 py-0.5 rounded-md bg-gray-100 text-gray-500 flex-shrink-0 font-mono">
                                            @file.FileType
                                        </span>

                                        <!-- Action buttons (visible on hover) -->
                                        <div class="file-actions flex items-center gap-1 flex-shrink-0">

                                            <a href="@file.FileUrl" download
                                               class="action-btn" title="Download">
                                                <i class="fa-solid fa-download text-xs"></i>
                                            </a>

                                            <button type="button"
                                                    onclick="openPreview('@file.FileUrl', '@file.FileName', '@file.FileType')"
                                                    class="action-btn" title="Preview">
                                                <i class="fa-solid fa-eye text-xs"></i>
                                            </button>

                                                @if (User.IsInRole("Admin") || User.IsInRole("User"))
                                                {
                                                    <form method="post" action="/Home/DeleteFile" style="display:contents;">
                                                        <input type="hidden" name="fileId" value="@file.Id" />
                                                        <input type="hidden" name="moduleId" value="@Model.ModuleSlug" />
                                                        <button type="submit"
                                                        onclick="return confirm('Delete this version?')"
                                                        class="action-btn danger" title="Delete">
                                                            <i class="fa-solid fa-trash text-xs"></i>
                                                        </button>
                                                    </form>
                                                }

                                            </div>
                                    </div>

                                    <!-- Version history -->
                                    @if (group.History.Any())
                                    {
                                        <div id="history-@file.Id" style="display:none;" class="bg-[#FAFBFF]">
                                            @foreach (var old in group.History)
                                            {
                                                <div class="version-row flex items-center gap-4 px-5 py-3 ml-5">
                                                    <div class="w-8 h-8 rounded-lg @iconBg flex items-center justify-center flex-shrink-0">
                                                        <i class="@iconClass @iconColor text-xs"></i>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center gap-2">
                                                            <p class="text-xs text-gray-500 truncate">
                                                                @(old.OriginalFileName ?? old.FileName)
                                                            </p>
                                                            <span class="text-[9px] font-bold bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded font-mono">
                                                                Old Version
                                                            </span>
                                                        </div>
                                                        <p class="text-[10px] text-gray-400 mt-0.5">
                                                            @old.UploadedDateFormatted · @old.FileSize
                                                        </p>
                                                    </div>
                                                    <a href="@old.FileUrl" download
                                                       class="action-btn" title="Download">
                                                        <i class="fa-solid fa-download text-xs"></i>
                                                    </a>
                                                        <form method="post" action="/Home/DeleteFile" style="display:contents;">
                                                            <input type="hidden" name="fileId" value="@old.Id" />
                                                            <input type="hidden" name="moduleId" value="@Model.ModuleSlug" />
                                                            <button type="submit"
                                                                    onclick="return confirm('Delete this version?')"
                                                                    class="action-btn danger" title="Delete">
                                                                <i class="fa-solid fa-trash text-xs"></i>
                                                            </button>
                                                        </form>
                                                </div>
                                            }
                                        </div>
                                    }

                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <!-- Empty state with drag-drop hint -->
                        <div class="px-8 py-16 flex flex-col items-center justify-center text-center">
                            <div class="w-16 h-16 rounded-2xl bg-[#EEF2FF] flex items-center justify-center mb-4">
                                <i class="fa-solid fa-cloud-arrow-up text-[#1B2A6B] text-2xl"></i>
                            </div>
                            <p class="text-sm font-semibold text-[#1B2A6B] mb-1">No files yet</p>
                            <p class="text-xs text-gray-400 max-w-xs leading-relaxed">
                                Supports PDF, DOCX, XLSX.
                            </p>
                            <div class="mt-5 flex items-center gap-2 text-[10px] text-gray-300">
                                <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-400 font-mono font-bold">PDF</span>
                                <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-400 font-mono font-bold">DOCX</span>
                                <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-400 font-mono font-bold">XLSX</span>
                                <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-400 font-mono font-bold">PPTX</span>
                            </div>
                        </div>
                    }
                    </div>

                </div>

                <!-- RIGHT: UPLOAD + TRASH -->
                <div class="w-72 flex-shrink-0 flex flex-col gap-4 sticky top-7 self-start">

                    @if (User.IsInRole("Admin") || User.IsInRole("User"))
                    {
                        <!-- Upload card -->
                        <form method="post" action="/Home/UploadFile" enctype="multipart/form-data">
                            <input type="hidden" name="moduleId" value="@Model.ModuleSlug" />

                            <div class="bg-white rounded-xl card shadow-sm p-5">

                                <div class="flex items-center gap-2 mb-4">
                                    <i class="fa-solid fa-cloud-arrow-up text-[#1B2A6B] text-sm"></i>
                                    <p class="text-sm font-semibold text-[#1B2A6B]">Upload File</p>
                                </div>

                                <!-- Dropzone -->
                                <div id="dropzone"
                                class="relative flex flex-col items-center justify-center rounded-xl p-6 text-center transition-all"
                                style="border: 2px dashed #CBD5E1; background: #F8F9FF; cursor: pointer;"
                                onclick="document.getElementById('file-input').click()"
                                ondragover="event.preventDefault(); this.classList.add('dropzone-active')"
                                ondragleave="this.classList.remove('dropzone-active')"
                                ondrop="handleDrop(event)">

                                    <div class="w-10 h-10 rounded-xl bg-[#EEF2FF] flex items-center justify-center mb-2">
                                        <i class="fa-solid fa-cloud-arrow-up text-[#1B2A6B] text-lg"></i>
                                    </div>

                                    <p class="text-xs font-semibold text-[#1B2A6B]">Drag &amp; drop files here</p>
                                    <p class="text-[10px] text-gray-400 mt-0.5">or click to browse</p>
                                    <p class="text-[10px] text-gray-300 mt-2">Supports PDF, DOCX, XLSX</p>

                                    <input type="file"
                                    name="file"
                                    id="file-input"
                                    class="hidden"
                                    accept=".pdf,.docx,.xlsx,.pptx"
                                    onchange="onFileSelected(this)" />
                                </div>

                                <!-- File preview -->
                                <div id="file-info"
                                class="hidden mt-3 rounded-lg p-3 flex items-center gap-3"
                                style="background: #F5F6FA; border: 1px solid #E8EAF0;">
                                    <i id="file-info-icon" class="fa-solid fa-file text-gray-400 text-lg flex-shrink-0"></i>
                                    <div class="min-w-0">
                                        <p id="file-info-name" class="text-xs font-semibold text-[#1B2A6B] truncate"></p>
                                        <p id="file-info-size" class="text-[10px] text-gray-400 mt-0.5"></p>
                                    </div>
                                    <button type="button" onclick="clearFile()"
                                    class="ml-auto text-gray-300 hover:text-red-400 transition flex-shrink-0">
                                        <i class="fa-solid fa-xmark text-xs"></i>
                                    </button>
                                </div>

                                <!-- Description -->
                                <div class="mt-3">
                                    <label class="text-[11px] font-semibold text-[#1B2A6B] block mb-1">
                                        Description <span class="text-gray-300 font-normal">(optional)</span>
                                    </label>
                                    <textarea name="description"
                                    id="desc-textarea"
                                    maxlength="200"
                                    rows="3"
                                    oninput="updateCounter(this)"
                                    placeholder="What is this file about?"
                                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-xs text-gray-700 resize-none transition"
                                    style="background: #FAFBFF;"></textarea>
                                    <div class="text-[10px] text-gray-400 text-right mt-0.5">
                                        <span id="char-count">0</span>/200
                                    </div>
                                </div>

                                <!-- Upload button — disabled until file selected -->
                                <button id="upload-btn"
                                type="submit"
                                disabled
                                class="w-full mt-3 text-white text-xs font-semibold py-2.5 rounded-lg transition"
                                style="background: #CBD5E1;">
                                    <i class="fa-solid fa-upload mr-1.5"></i> Upload
                                </button>

                            </div>
                        </form>
                    }


                </div>
            </div>
        </div>
    </div>
</div>

<!-- PREVIEW MODAL -->
<!-- PREVIEW MODAL -->
<div id="preview-modal"
     class="fixed inset-0 z-50 items-center justify-center"
     style="background: rgba(8,10,20,0.85); display:none; backdrop-filter: blur(4px);">

    <div class="flex flex-col overflow-hidden"
         style="width: 92vw; height: 92vh; background: #0F1117; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; box-shadow: 0 32px 80px rgba(0,0,0,0.6);">

        <!-- Modal header -->
        <div class="flex items-center justify-between px-5 py-3 flex-shrink-0"
             style="border-bottom: 1px solid rgba(255,255,255,0.07); background: #161820;">

            <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg flex items-center justify-center"
                     style="background: rgba(27,42,107,0.6); border: 1px solid rgba(27,42,107,0.8);">
                    <i class="fa-solid fa-file text-blue-300 text-xs"></i>
                </div>
                <p id="preview-title" class="text-sm font-semibold text-white/90"></p>
            </div>

            <div class="flex items-center gap-2">
                <!-- Download button -->
                <a id="preview-download"
                   href="#"
                   download
                   class="flex items-center gap-1.5 text-[11px] font-semibold px-3 py-1.5 rounded-lg transition"
                   style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.6);">
                    <i class="fa-solid fa-download text-[10px]"></i>
                    Download
                </a>

                <button type="button" onclick="closePreview()"
                        class="w-7 h-7 rounded-lg flex items-center justify-center transition"
                        style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); color: rgba(255,255,255,0.4);"
                        onmouseover="this.style.background='rgba(255,255,255,0.12)'; this.style.color='white'"
                        onmouseout="this.style.background='rgba(255,255,255,0.06)'; this.style.color='rgba(255,255,255,0.4)'">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
        </div>

        <!-- Modal body -->
        <div class="flex-1 overflow-hidden" style="background: #0F1117;">
            <iframe id="preview-frame" src="" class="w-full h-full border-0" style="display:none;"></iframe>

            <!-- Fallback -->
            <div id="preview-fallback"
                 class="w-full h-full flex flex-col items-center justify-center"
                 style="display:none;">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-4"
                     style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);">
                    <i class="fa-solid fa-file-circle-question text-3xl" style="color: rgba(255,255,255,0.2);"></i>
                </div>
                <p class="text-sm font-semibold mb-1" style="color: rgba(255,255,255,0.7);">Preview not available</p>
                <p class="text-xs mb-5" style="color: rgba(255,255,255,0.3);">This file type cannot be previewed in the browser.</p>
                <a id="fallback-download" href="#"
                   class="text-white text-xs font-semibold px-5 py-2.5 rounded-lg transition"
                   style="background: #1B2A6B; border: 1px solid rgba(255,255,255,0.1);">
                    <i class="fa-solid fa-download mr-1.5"></i> Download Instead
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    /* ─── PREVIEW ─── */
    function openPreview(url, fileName, fileType) {
        document.getElementById('preview-title').textContent = fileName;

        // Build download URL that forces download instead of opening in browser
        const withoutSlash = url.startsWith('/') ? url.slice(1) : url;
        const parts        = withoutSlash.split('/');
        const moduleId     = parts[1];
        const name         = parts.slice(2).join('/');
        const downloadUrl  = `/Home/DownloadFile?moduleId=${encodeURIComponent(moduleId)}&fileName=${encodeURIComponent(name)}`;

        document.getElementById('preview-download').href = downloadUrl;

        const frame    = document.getElementById('preview-frame');
        const fallback = document.getElementById('preview-fallback');
        const modal    = document.getElementById('preview-modal');

        frame.style.display    = 'none';
        fallback.style.display = 'none';
        frame.src = '';

        const type         = fileType.toLowerCase();
        const downloadOnly = ['zip','rar','mp4','mp3','xlsx','xls','pptx','ppt'];

        if (downloadOnly.includes(type)) {
            document.getElementById('fallback-download').href = downloadUrl;
            fallback.style.display = 'flex';
        } else {
            if (!moduleId || !name) {
                document.getElementById('fallback-download').href = downloadUrl;
                fallback.style.display = 'flex';
            } else {
                frame.src = `/Home/PreviewFile?moduleId=${encodeURIComponent(moduleId)}&fileName=${encodeURIComponent(name)}`;
                frame.style.display = 'block';
            }
        }

        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closePreview() {
        document.getElementById('preview-modal').style.display = 'none';
        document.getElementById('preview-frame').src = '';
        document.body.style.overflow = '';
    }

    document.getElementById('preview-modal').addEventListener('click', function(e) {
        if (e.target === this) closePreview();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closePreview();
    });

    /* ─── FILE SELECTION ─── */
    function onFileSelected(input) {
        const file = input.files[0];
        if (!file) return;
        applyFileInfo(file);
    }

    function handleDrop(e) {
        e.preventDefault();
        document.getElementById('dropzone').classList.remove('dropzone-active');
        const file = e.dataTransfer.files[0];
        if (!file) return;
        const dt = new DataTransfer();
        dt.items.add(file);
        document.getElementById('file-input').files = dt.files;
        applyFileInfo(file);
    }

    function applyFileInfo(file) {
        const nameEl = document.getElementById('file-info-name');
        const sizeEl = document.getElementById('file-info-size');
        const iconEl = document.getElementById('file-info-icon');
        const info   = document.getElementById('file-info');
        const btn    = document.getElementById('upload-btn');

        const ext = file.name.split('.').pop().toLowerCase();
        const iconMap = {
            pdf:  'fa-solid fa-file-pdf text-red-500',
            docx: 'fa-solid fa-file-word text-blue-500',
            doc:  'fa-solid fa-file-word text-blue-500',
            xlsx: 'fa-solid fa-file-excel text-emerald-500',
            xls:  'fa-solid fa-file-excel text-emerald-500',
            pptx: 'fa-solid fa-file-powerpoint text-orange-500',
        };
        iconEl.className = (iconMap[ext] || 'fa-solid fa-file text-gray-400') + ' text-lg flex-shrink-0';

        const bytes = file.size;
        nameEl.textContent = file.name;
        sizeEl.textContent = bytes < 1024 ? bytes + ' B'
            : bytes < 1024*1024 ? (bytes/1024).toFixed(1)+' KB'
            : (bytes/(1024*1024)).toFixed(1)+' MB';

        info.classList.remove('hidden');

        btn.disabled = false;
        btn.style.background = '#1B2A6B';
        btn.onmouseover = () => btn.style.background = '#152255';
        btn.onmouseout  = () => btn.style.background = '#1B2A6B';
    }

    function clearFile() {
        document.getElementById('file-input').value = '';
        document.getElementById('file-info').classList.add('hidden');
        const btn = document.getElementById('upload-btn');
        btn.disabled = true;
        btn.style.background = '#CBD5E1';
        btn.onmouseover = null;
        btn.onmouseout  = null;
    }

    /* ─── CHAR COUNTER ─── */
    function updateCounter(el) {
        document.getElementById('char-count').textContent = el.value.length;
    }

    /* ─── VERSION HISTORY TOGGLE ─── */
    function toggleHistory(id) {
        const el = document.getElementById(id);
        el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    /* ─── SEARCH ─── */
    function searchFiles(q) {
        const query   = q.toLowerCase().trim();
        const items   = document.querySelectorAll('#file-list li');
        let   visible = 0;

        items.forEach(li => {
            const match = (li.getAttribute('data-filename') || '').includes(query);
            li.style.display = match ? '' : 'none';
            if (match) visible++;
        });

        document.getElementById('file-count').textContent = visible + ' file(s)';

        const empty = document.getElementById('no-files-found');
        if (empty) empty.style.display = visible === 0 && query !== '' ? 'block' : 'none';
    }
</script>
