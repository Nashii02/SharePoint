@model WorkInstructionViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Work Instructions";

    var categoryIcons = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "Engineering & Technical Systems",  "fa-solid fa-gears" },
        { "HR, Admin & Finance",              "fa-solid fa-users" },
        { "IT & Support Systems",             "fa-solid fa-server" },
        { "Operations & Logistics",           "fa-solid fa-truck" },
        { "Records, Documents & Compliance",  "fa-solid fa-clipboard-list" },
        { "Uncategorized",                    "fa-solid fa-folder" },
    };

    // Gets color stored in DB for a category
    string GetStoredColor(IList<WorkInstructionCard> cards)
        => cards.FirstOrDefault()?.CategoryColor ?? "";

    // Fallback: auto-assign consistent color from category name
    string GetHashAccent(string category, string type)
    {
        int hash = 0;
        foreach (char c in (category ?? "").ToLower())
            hash = (hash * 31 + c) % 8;

        var palettes = new[]
        {
            ("bg-emerald-50", "text-emerald-700", "border-emerald-200"),
            ("bg-blue-50",    "text-blue-700",    "border-blue-200"),
            ("bg-amber-50",   "text-amber-700",   "border-amber-200"),
            ("bg-violet-50",  "text-violet-700",  "border-violet-200"),
            ("bg-rose-50",    "text-rose-700",    "border-rose-200"),
            ("bg-cyan-50",    "text-cyan-700",    "border-cyan-200"),
            ("bg-orange-50",  "text-orange-700",  "border-orange-200"),
            ("bg-pink-50",    "text-pink-700",    "border-pink-200"),
        };

        var (bg, text, border) = palettes[hash];
        return type switch { "bg" => bg, "text" => text, "border" => border, _ => bg };
    }
}

<!-- Dependencies -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style>
    * {
        font-family: 'DM Sans', sans-serif;
    }

    /* Hero dot-grid texture */
    .hero-texture {
        background-image: radial-gradient(circle, rgba(255,255,255,0.10) 1px, transparent 1px);
        background-size: 22px 22px;
    }

    /* Stat pill glassmorphism */
    .stat-pill {
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.12);
        backdrop-filter: blur(4px);
    }

    /* Card hover lift */
    .module-card {
        transition: box-shadow 0.18s, transform 0.18s, border-left-color 0.18s;
    }

        .module-card:hover {
            box-shadow: 0 4px 16px rgba(27,42,107,0.10);
            transform: translateY(-1px);
            border-left-color: #1B2A6B !important;
        }

    /* Featured card */
    .featured-card {
        transition: box-shadow 0.18s, transform 0.18s;
    }

        .featured-card:hover {
            box-shadow: 0 6px 20px rgba(27,42,107,0.12);
            transform: translateY(-2px);
        }

    /* Search focus ring */
    #global-search:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(27,42,107,0.20);
    }

    /* Thin scrollbar */
    ::-webkit-scrollbar {
        width: 4px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }

    /* Modal inputs */
    .modal-input:focus {
        outline: none;
        border-color: #1B2A6B;
        box-shadow: 0 0 0 2px rgba(27,42,107,0.12);
    }

    /* Add module dashed card */
    .add-card {
        border: 2px dashed #CBD5E1;
        transition: border-color 0.18s, background 0.18s;
    }

        .add-card:hover {
            border-color: #1B2A6B;
            background: #F0F3FF;
        }
</style>

<div class="min-h-screen flex flex-col bg-[#FFFFFF]">

    <!-- HERO -->
    <section class="bg-[#1B2A6B] text-white relative overflow-hidden"
             style="box-shadow: 0 4px 24px rgba(27,42,107,0.22);">

        <!-- Dot texture -->
        <div class="hero-texture absolute inset-0 pointer-events-none"></div>
        <!-- Radial glow accent -->
        <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full pointer-events-none opacity-[0.06]"
             style="background: radial-gradient(circle, #ffffff 0%, transparent 70%);"></div>

        <!-- Faded Background LOGO-->
        <div class="absolute right-10 bottom-0 pointer-events-none hidden md:block">
            <img src="~/images/NoBGLogo.png"
                 class="w-80 h-80 object-contain filter brightness-0 invert opacity-[0.07] translate-y-8" /></div>

        <div class="relative max-w-7xl mx-auto px-8">

            <!-- ── Integrated Navbar Row ── -->
            <div class="flex items-center justify-between py-4"
                 style="border-bottom: 1px solid rgba(255,255,255,0.08);">

                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-white/15 flex items-center justify-center">
                        <img src="~/images/NoBGLogo.png"
                             class="w-5 h-5 object-contain filter brightness-0 invert"
                             alt="Logo" />
                    </div>
                    <span class="text-sm font-semibold text-white/90 tracking-tight">IT Solutions</span>
                    <span class="text-white/20 text-xs">|</span>
                    <span class="text-xs text-blue-300/80 font-medium">Work Instructions</span>
                </div>

                <!-- Nav actions -->
                <div class="flex items-center gap-3">
                    <!-- Global search -->
                    <div class="flex items-center gap-2 rounded-lg px-3 py-2"
                         style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); width: 220px;">
                        <i class="fa-solid fa-magnifying-glass text-white/40 text-xs"></i>
                        <input id="global-search"
                               type="text"
                               placeholder="Search modules..."
                               oninput="searchModules(this.value)"
                               class="bg-transparent text-xs text-white placeholder-white/30 flex-1 transition"
                               style="outline:none;" />
                    </div>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="flex items-center gap-1.5 text-xs text-white/50">
                            <i class="fa-solid fa-user text-[10px]"></i>
                            <span>@User.Identity?.Name</span>
                        </div>
                        <form method="post" asp-controller="Account" asp-action="Logout" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-lg transition"
                                    style="background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.15);">
                                <i class="fa-solid fa-right-from-bracket text-[10px]"></i>
                                Sign out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login?returnUrl=/Home/WorkInstruction"
                           class="flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-lg transition"
                           style="background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.15);">
                            <i class="fa-solid fa-right-to-bracket text-[10px]"></i>
                            Sign in
                        </a>
                    }
                    
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="relative" id="admin-dropdown-wrapper">
                                <button type="button"
                                        onclick="toggleAdminDropdown()"
                                        id="admin-dropdown-btn"
                                        class="flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-lg transition"
                                        style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15);">
                                    Admin
                                    <i class="fa-solid fa-chevron-down text-[8px] ml-0.5" id="admin-chevron"></i>
                                </button>

                                <div id="admin-dropdown"
                                     style="display:none; position:absolute; top:calc(100% + 8px); right:0; width:200px; background:#fff; border:1px solid #E8EAF0; border-radius:12px; box-shadow:0 8px 24px rgba(27,42,107,0.12); z-index:9999; overflow:hidden;">

                                    <!-- Section: Content -->
                                    <div style="padding: 6px;">
                                        <p style="font-size:9px; font-weight:700; color:#9CA3AF; letter-spacing:0.08em; text-transform:uppercase; padding: 6px 10px 4px;">Content</p>

                                        <button type="button" onclick="openAddModal(); closeAdminDropdown();"
                                                style="width:100%; display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; border:none; background:transparent; cursor:pointer; text-align:left;"
                                                onmouseover="this.style.background='#F5F7FF'" onmouseout="this.style.background='transparent'">
                                            <div style="width:28px; height:28px; border-radius:7px; background:#EEF2FF; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                                <i class="fa-solid fa-plus" style="color:#1B2A6B; font-size:11px;"></i>
                                            </div>
                                            <div>
                                                <p style="font-size:12px; font-weight:600; color:#1B2A6B; margin:0; line-height:1.2;">Add Module</p>
                                                <p style="font-size:10px; color:#9CA3AF; margin:0; line-height:1.4;">Create a new work instruction</p>
                                            </div>
                                        </button>

                                        <button type="button" onclick="toggleEditMode(); closeAdminDropdown();"
                                                style="width:100%; display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; border:none; background:transparent; cursor:pointer; text-align:left;"
                                                onmouseover="this.style.background='#F5F7FF'" onmouseout="this.style.background='transparent'">
                                            <div style="width:28px; height:28px; border-radius:7px; background:#FFFBEB; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                                <i class="fa-solid fa-pen" style="color:#D97706; font-size:11px;"></i>
                                            </div>
                                            <div>
                                                <p style="font-size:12px; font-weight:600; color:#1B2A6B; margin:0; line-height:1.2;">Edit Module</p>
                                                <p style="font-size:10px; color:#9CA3AF; margin:0; line-height:1.4;">Click a card to edit it</p>
                                            </div>
                                        </button>
                                    </div>

                                    <!-- Divider -->
                                    <div style="height:1px; background:#F0F1F5; margin:0 6px;"></div>

                                    <!-- Section: Users -->
                                    <div style="padding: 6px;">
                                        <p style="font-size:9px; font-weight:700; color:#9CA3AF; letter-spacing:0.08em; text-transform:uppercase; padding: 6px 10px 4px;">Users</p>

                                        <a href="/Account/ManageUsers"
                                           style="width:100%; display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; text-decoration:none;"
                                           onmouseover="this.style.background='#F5F7FF'" onmouseout="this.style.background='transparent'">
                                            <div style="width:28px; height:28px; border-radius:7px; background:#F0FDF4; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                                <i class="fa-solid fa-users-gear" style="color:#16A34A; font-size:11px;"></i>
                                            </div>
                                            <div>
                                                <p style="font-size:12px; font-weight:600; color:#1B2A6B; margin:0; line-height:1.2;">Manage Users</p>
                                                <p style="font-size:10px; color:#9CA3AF; margin:0; line-height:1.4;">Roles, access & accounts</p>
                                            </div>
                                        </a>
                                    </div>

                                </div>
                            </div>
                        }
                        

                    

                    
                </div>
            </div>

            <!-- ── Hero Title + Stats Row ── -->
            <div class="flex items-end justify-between gap-6 py-8 flex-wrap">

                <!-- Title block -->
                <div>
                    <p class="text-[11px] font-semibold text-blue-300/70 uppercase tracking-widest mb-2">
                        IT Knowledge Base
                    </p>
                    <h1 class="text-5xl font-bold leading-none tracking-tight">
                        WORK<br />INSTRUCTIONS
                    </h1>
                    <p class="text-blue-200/60 text-sm mt-3 max-w-xs leading-relaxed">
                        Step-by-step guides for all IT systems and processes.
                    </p>
                </div>

                <!-- Stat pills (right-aligned, inside hero) -->
                <div class="flex items-center gap-3 pb-1 flex-wrap">
 
                    <div class="stat-pill flex items-center gap-2.5 rounded-xl px-4 py-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                             style="background: rgba(255,255,255,0.12);">
                            <i class="fa-solid fa-table-cells text-white text-sm"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-blue-200/60 leading-none">Total Modules</p>
                            <p class="text-lg font-bold text-white leading-tight mt-0.5">@Model.TotalModules</p>
                        </div>
                    </div>

                    <div class="stat-pill flex items-center gap-2.5 rounded-xl px-4 py-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                             style="background: rgba(255,255,255,0.12);">
                            <i class="fa-solid fa-folder text-white text-sm"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-blue-200/60 leading-none">Categories</p>
                            <p class="text-lg font-bold text-white leading-tight mt-0.5">@Model.TotalCategories</p>
                        </div>
                    </div>

                    <div class="stat-pill flex items-center gap-2.5 rounded-xl px-4 py-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                             style="background: rgba(255,255,255,0.12);">
                            <i class="fa-solid fa-clock-rotate-left text-white text-sm"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-blue-200/60 leading-none">Recently Updated</p>
                            <p class="text-lg font-bold text-white leading-tight mt-0.5">@Model.RecentlyUpdatedCount</p>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- BODY -->
    <div class="flex-1 py-8 m-4">
        <div class="max-w-7xl mx-auto px-8">

            <!-- RECENTLY UPDATED -->
            @if (Model.FeaturedCards.Any())
            {
                <div id="featured-section" class="mb-10">

                    <!-- Section eyebrow -->
                    <div class="flex items-center gap-3 mb-4">
                        <span class="text-[11px] font-bold text-[#1B2A6B] uppercase tracking-widest">
                            Recently Updated
                        </span>
                        <span class="text-[10px] font-semibold bg-[#EEF2FF] text-[#1B2A6B] px-2 py-0.5 rounded-full">
                            @Model.FeaturedCards.Count
                        </span>
                        <div class="flex-1 h-px bg-gradient-to-r from-[#E0E4F4] to-transparent"></div>
                        <button type="button"
                                id="toggle-featured-btn"
                                onclick="toggleFeatured()"
                                class="flex items-center gap-1.5 text-[11px] font-semibold text-[#1B2A6B]/60 hover:text-[#1B2A6B] transition">
                            <span id="toggle-featured-label">See all</span>
                            <i id="toggle-featured-icon" class="fa-solid fa-chevron-down text-[8px]"></i>
                        </button>
                    </div>

                    <!-- Featured card grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        @{
                            int featuredIndex = 0;
                        }
                        @foreach (var item in Model.FeaturedCards)
                        {
                            var badgeCls = item.StatusColor switch
                            {
                                "updated" => "bg-emerald-100 text-emerald-700",
                                "review" => "bg-amber-100 text-amber-700",
                                "pinned" => "bg-[#EEF2FF] text-[#1B2A6B]",
                                "new" => "bg-purple-100 text-purple-700",
                                _ => "bg-[#EEF2FF] text-[#1B2A6B]"
                            };

                            var isExtra = featuredIndex >= 4;
                            var extraCls = isExtra ? "featured-extra" : "";
                            var extraStyl = isExtra ? "display:none;" : "";

                            <a href="@item.URL"
                               class="featured-card bg-[#E2EBE2]/20 rounded-xl p-4 flex flex-col @extraCls"
                               data-title="@item.Title.ToLower()"
                               style="border: 1px solid #E8EAF0; border-left: 3px solid #1B2A6B; @extraStyl">

                                <!-- Icon + badge row -->
                                <div class="flex items-start justify-between mb-3">
                                    <div class="w-9 h-9 rounded-lg bg-[#EEF2FF] flex items-center justify-center flex-shrink-0">
                                        <i class="@item.IconClass text-[#1B2A6B] text-base"></i>
                                    </div>
                                    <span class="text-[9px] font-bold px-2 py-0.5 rounded-full @badgeCls">
                                        @item.Status
                                    </span>
                                </div>

                                <!-- Title + subtitle -->
                                <p class="text-sm font-semibold text-[#1B2A6B] leading-snug mb-1">@item.Title</p>
                                <p class="text-[11px] text-gray-400 leading-relaxed flex-1 line-clamp-2">@item.Subtitle</p>

                                <!-- Footer -->
                                <div class="mt-3 pt-3 flex items-center justify-between"
                                     style="border-top: 1px solid #F0F1F5;">
                                    <span class="text-[10px] text-gray-300 flex items-center gap-1">
                                        <i class="fa-solid fa-clock text-[8px]"></i>
                                        @item.LastUpdated
                                    </span>
                                    <i class="fa-solid fa-arrow-right text-[#1C3667]/70 text-xs"></i>
                                </div>

                            </a>
                            featuredIndex++;
                        }
                    </div>
                </div>
            }

            <!-- SECONDARY CARDS — grouped by category -->
            @foreach (var group in Model.GroupedSecondaryCards)
            {
                var icon = categoryIcons.TryGetValue(group.Key, out var ic) ? ic : "fa-solid fa-folder";
                var storedColor = GetStoredColor(group.Value);
                var hasColor = !string.IsNullOrEmpty(storedColor);
                var accentBg = hasColor ? "" : GetHashAccent(group.Key, "bg");
                var accentText = hasColor ? "" : GetHashAccent(group.Key, "text");
                var accentBorder = hasColor ? "" : GetHashAccent(group.Key, "border");
                var inlineStyle = hasColor ? $"background:{storedColor}22; border-color:{storedColor}55; color:{storedColor};" : "";
                var iconInline = hasColor ? $"color:{storedColor};" : "";

                <div class="category-group mb-8" data-category="@group.Key.ToLower()">

                    <!-- Category eyebrow -->
                    <div class="flex items-center gap-2.5 mb-3">
                        <div class="w-6 h-6 rounded-md @accentBg @accentBorder border flex items-center justify-center flex-shrink-0"
                             style="@inlineStyle">
                            <i class="@icon @accentText text-[11px]" style="@iconInline"></i>
                        </div>
                        <span class="text-[11px] font-bold text-[#1B2A6B] uppercase tracking-widest">@group.Key</span>
                        <span class="text-[10px] text-gray-400 font-medium">@group.Value.Count module(s)</span>
                        <div class="flex-1 h-px bg-gradient-to-r from-[#E0E4F4] to-transparent"></div>
                    </div>

                    <!-- Module cards grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                        @foreach (var item in group.Value)
                        {
                            var mBg = hasColor ? "" : GetHashAccent(item.Category ?? group.Key, "bg");
                            var mText = hasColor ? "" : GetHashAccent(item.Category ?? group.Key, "text");
                            var mBorder = hasColor ? "" : GetHashAccent(item.Category ?? group.Key, "border");

                            <div class="module-card bg-[#E2EBE2]/20 rounded-xl p-3 relative"
                                 data-title="@item.Title.ToLower()"
                                 data-slug="@item.URL.Split('=').Last()"
                                 data-subtitle="@item.Subtitle"
                                 data-icon="@item.IconClass"
                                 data-category="@item.Category"
                                 data-color="@item.CategoryColor"
                                 onclick="handleCardClick(this)"
                                 style="border: 1px solid #E8EAF0; border-left: 3px solid transparent; cursor: pointer;">

                                <!-- Edit mode indicator (hidden by default) -->
                                <div class="edit-indicator absolute top-2 right-2 w-5 h-5 rounded-full bg-amber-400 items-center justify-center hidden">
                                    <i class="fa-solid fa-pen text-white text-[8px]"></i>
                                </div>

                                <div class="flex items-center gap-2.5">
                                    <div class="w-9 h-9 rounded-lg @mBg @mBorder border flex items-center justify-center flex-shrink-0"
                                         style="@inlineStyle">
                                        <i class="@item.IconClass @mText text-base" style="@iconInline"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm font-semibold text-[#1B2A6B] leading-snug truncate">@item.Title</p>
                                        <p class="text-[10px] text-gray-400 mt-0.5 leading-snug truncate">@item.Subtitle</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }


            <!-- No results -->
            <div id="no-results" style="display:none;"
                 class="text-center py-20">
                <div class="w-14 h-14 rounded-2xl bg-[#EEF2FF] flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-magnifying-glass text-[#1B2A6B] text-xl"></i>
                </div>
                <p class="text-sm font-semibold text-gray-500">No modules found</p>
                <p class="text-xs text-gray-400 mt-1">Try a different search term</p>
            </div>
            @if (!Model.GroupedSecondaryCards.Any())
            {
                <div class="flex flex-col items-center justify-center py-24 text-center">
                    <div class="w-20 h-20 rounded-2xl bg-[#EEF2FF] flex items-center justify-center mx-auto mb-5">
                        <i class="fa-solid fa-box-open text-[#1B2A6B] text-3xl"></i>
                    </div>
                    <p class="text-base font-bold text-[#1B2A6B] mb-1">No modules yet</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <p class="text-xs text-gray-400 max-w-xs leading-relaxed mb-5">
                            Get started by adding your first work instruction module.
                        </p>
                        <button type="button" onclick="openAddModal()"
                                class="flex items-center gap-2 bg-[#1B2A6B] hover:bg-[#152255] text-white text-xs font-semibold px-5 py-2.5 rounded-lg transition">
                            <i class="fa-solid fa-plus text-[10px]"></i>
                            Add your first module
                        </button>
                    }
                    else
                    {
                        <p class="text-xs text-gray-400 max-w-xs leading-relaxed">
                            No work instruction modules have been added yet. Check back later.
                        </p>
                    }
                </div>
            }

        </div>
    </div>

</div>

<!-- ADD MODULE MODAL -->
<div id="add-modal"
     class="fixed inset-0 flex items-center justify-center z-[9999]"
     style="background: rgba(15,20,50,0.55); backdrop-filter: blur(2px); display:none !important;">

    <div class="bg-white rounded-2xl shadow-2xl p-6 overflow-y-auto"
         style="width: 440px; max-height: 90vh; border: 1px solid #E8EAF0;">

        <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-[#EEF2FF] flex items-center justify-center">
                    <i class="fa-solid fa-plus text-[#1B2A6B] text-xs"></i>
                </div>
                <p class="text-sm font-semibold text-[#1B2A6B]">Add New Module</p>
            </div>
            <button onclick="closeAddModal()"
                    class="w-7 h-7 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-600 transition">
