@{
    ViewData["Title"] = "Work Instructions";
    var categories = ViewBag.Categories as List<Sharepoint.Models.WorkCategory> ?? new();
}

<script src="https://cdn.tailwindcss.com"></script>

<style>
    .wi-cards-section-wrapper {
        background: #ECFFEC;
        width: 100%;
    }

    .wi-cards-section {
        padding: 40px 2rem 60px;
        max-width: 80rem;
        margin: 0 auto;
    }

    .wi-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .wi-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        background: white;
        border: 1.5px solid #c8e6d4;
        border-left: 4px solid #1C3667;
        border-bottom: 4px solid #1C3667;
        border-radius: 14px;
        padding: 22px 20px;
        box-shadow: 0 2px 8px rgba(26,47,110,0.10);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .wi-card:hover {
            transform: translateY(2px) scale(0.98);
            box-shadow: none;
            border-color: white;
            border-left-color: white;
        }

            .wi-card:hover .wi-card-arrow {
                opacity: 1;
                transform: translateX(0);
            }

            .wi-card:hover .delete-cat-btn {
                opacity: 1;
                background-color: #fff1f2;
                border-color: #fca5a5;
                color: #ef4444;
            }

        .wi-card:active {
            transform: translateY(4px) scale(0.96);
            box-shadow: none;
            border-left-color: #1C3667;
            border-color: #c8e6d4;
            transition: transform 0.08s ease, box-shadow 0.08s ease;
        }

    .wi-card-icon {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        background: #ECFFEC;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1C3667;
    }

        .wi-card-icon svg {
            width: 22px;
            height: 22px;
        }

    .wi-card-body {
        flex: 1;
        min-width: 0;
    }

    .wi-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #1C3667;
        margin: 0 0 6px 0;
    }

    .wi-card-desc {
        font-size: 13px;
        color: #4a5568;
        line-height: 1.55;
        margin: 0;
    }

    .wi-card-arrow {
        flex-shrink: 0;
        color: #1C3667;
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.2s, transform 0.2s;
        margin-top: 2px;
    }

        .wi-card-arrow svg {
            width: 18px;
            height: 18px;
        }

    .delete-cat-btn {
        position: absolute;
        bottom: 8px;
        right: 8px;
        opacity: 0;
        transition: opacity 0.2s, background-color 0.15s, border-color 0.15s, color 0.15s;
    }

    .delete-cat-btn:hover {
        background-color: #dc3545 !important;
        border-color: #fca5a5 !important;
        color: white !important;
    }

    .wi-card-add {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: white;
        border: 2px dashed #c8e6d4;
        border-radius: 14px;
        padding: 22px 20px;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        min-height: 110px;
    }

        .wi-card-add:hover {
            border-color: #1C3667;
            background: #f7fff7;
        }

        .wi-card-add span {
            font-size: 13px;
            font-weight: 600;
            color: #1C3667;
            opacity: 0.6;
        }

        .wi-card-add:hover span {
            opacity: 1;
        }

    .icon-option {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: 2px solid #c8e6d4;
        cursor: pointer;
        color: #1C3667;
        transition: border-color 0.15s, background 0.15s;
    }

        .icon-option:hover, .icon-option.selected {
            border-color: #1C3667;
            background: #ECFFEC;
        }
</style>

<div class="min-h-screen bg-[#ECFFEC]">

    <section class="bg-[#1C3667] text-white relative overflow-hidden">

        <!-- Circuit as full background -->
        <img src="~/images/circuit.png"
             class="absolute inset-0 w-full h-full object-cover filter brightness-0 invert opacity-10"
             style="z-index: 0;" />

        <!-- Circuit masked to logo shape -->
        <div class="absolute right-10 hidden md:block"
             style="z-index: 1; width: 320px; height: 320px; top: 50%; transform: translateY(-38%);
                mask-image: url('/images/NoBGLogo.png');
                mask-size: contain;
                mask-repeat: no-repeat;
                mask-position: center;
                opacity: 0.25;">
            <img src="~/images/circuit.png"
                 style="height: 100%; width: 100%; object-fit: cover;"
                 class="filter brightness-0 invert" />
        </div>

        <!-- Logo outline on top -->
        <div class="absolute right-10 hidden md:block" style="z-index: 2; top: 50%; transform: translateY(-38%); opacity: 0.15;">
            <img src="~/images/NoBGLogo.png" class="w-80 h-80 object-contain filter brightness-0 invert" />
        </div>

        <!-- Content -->
        <div class="max-w-7xl mx-auto px-6 py-10 relative" style="z-index: 2;">

            <div class="max-w-xl pl-20">
                <h1 style="letter-spacing: -1px;" class="text-5xl font-bold leading-none">WORK <br />INSTRUCTIONS</h1>
                <div class="mt-8 space-y-3 flex flex-col items-center">
                    <div class="flex gap-3 translate-x-10">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                        }
                    </div>
                    <div class="flex gap-3 translate-x-10">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-8 pt-6">
            <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 text-sm font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0"><polyline points="20 6 9 17 4 12" /></svg>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-8 pt-6">
            <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-800 rounded-xl px-4 py-3 text-sm font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    <div class="wi-cards-section-wrapper">

        <section class="wi-cards-section" style="position:relative; overflow:hidden;">
            <div class="wi-cards-grid" id="cardsGrid">
                <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); opacity:0.08; pointer-events:none; z-index:0;">
                    <img src="~/images/NoBGLogo.png" style="width:500px; height:500px; object-fit:contain; position:sticky; top:calc(50vh - 250px);" />
                </div>
                @foreach (var cat in categories)
                {
                    <div class="wi-card" data-title="@cat.Name" data-desc="@cat.Description"
                         onclick="window.location='/WorkInstructions/Upload?category=@cat.Slug'">

                        <div class="wi-card-icon">
                            @Html.Raw(GetIconSvg(cat.Icon))
                        </div>
                        <div class="wi-card-body">
                            <h3 class="wi-card-title">@cat.Name</h3>
                            <p class="wi-card-desc">@cat.Description</p>
                        </div>
                        <div class="wi-card-arrow">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </div>

                        @if (!cat.IsDefault)
                        {
                            <form method="post" asp-controller="WorkInstructions" asp-action="DeleteCategory"
                                  class="delete-form stop-prop" style="display:contents;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@cat.Id" />
                                <button type="submit" class="delete-cat-btn flex items-center justify-center w-6 h-6 rounded-md bg-white border border-[#c8e6d4] text-red-400"
                                        title="Delete category">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                </button>
                            </form>
                        }
                    </div>
                }

                <!-- Add Category Card -->
                <div class="wi-card-add" id="addCategoryBtn">
                    <div class="w-9 h-9 rounded-full border-2 border-dashed border-[#1C3667] flex items-center justify-center opacity-40">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#1C3667]">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                    </div>
                    <span>Add Category</span>
                </div>

                <!-- No results message (hidden by default) -->
                <p id="noResultsMsg" class="hidden text-sm text-gray-400 font-semibold col-span-full text-center py-10">
                    No categories match your search.
                </p>

            </div>
        </section>

        <!-- ADD CATEGORY MODAL -->
        <div id="addCategoryModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
            <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden">
                <div class="flex items-center justify-between px-6 py-4 bg-[#1C3667]">
                    <h3 class="text-sm font-bold text-white">New Category</h3>
                    <button id="closeModalBtn" class="flex items-center justify-center w-8 h-8 rounded-lg bg-white/10 text-white hover:bg-white/20 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
                <form method="post" asp-controller="WorkInstructions" asp-action="CreateCategory" class="p-6 space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-[#1C3667] mb-1.5">Category Name <span class="text-red-400">*</span></label>
                        <input type="text" name="name" id="categoryNameInput"
                               class="w-full px-3 py-2 text-sm border border-[#c8e6d4] rounded-lg outline-none focus:border-[#1C3667] transition-all"
                               placeholder="e.g. DevOps" required />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#1C3667] mb-1.5">Description <span class="font-normal text-gray-400">(optional)</span></label>
                        <textarea name="description"
                                  class="w-full px-3 py-2 text-sm border border-[#c8e6d4] rounded-lg outline-none focus:border-[#1C3667] transition-all resize-none"
                                  placeholder="Brief description of this category..." rows="2"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#1C3667] mb-2">Icon</label>
                        <div class="flex flex-wrap gap-2 max-h-36 overflow-y-auto pr-1" id="iconPicker">
                            @foreach (var icon in new[] {
                                                    "folder", "file-text", "server", "shield", "monitor", "users", "settings", "tool",
                                                    "database", "globe", "mail", "code",
                                                    "clipboard", "bar-chart", "trend-up", "edit", "image", "cpu", "grid", "sigma",
                                                    "truck", "plane", "building", "key", "activity", "package", "food",
                                                    "refresh", "lock", "calendar", "pie-chart", "wifi", "layers","banknote", "number-1",
                                                    "sticky-note", "door-exit", "finance", "ehss", "fleet", "chat", "ticket", "dots", "crane", "market"
                                                    })
                            {
                                <div class="icon-option @(icon == "folder" ? "selected" : "")" data-icon="@icon" title="@icon">
                                    @Html.Raw(GetIconSvg(icon))
                                </div>
                            }
                        </div>
                        <input type="hidden" name="icon" id="selectedIcon" value="folder" />
                    </div>
                    <div class="flex gap-2 pt-1">
                        <button type="button" id="cancelModalBtn"
                                class="flex-1 px-3 py-2 text-sm font-semibold text-[#1C3667] bg-white border border-[#c8e6d4] rounded-lg hover:bg-[#ECFFEC] transition-colors">
                            Cancel
                        </button>
                        <button type="submit"
                                class="flex-1 px-3 py-2 text-sm font-semibold text-white bg-[#1C3667] rounded-lg hover:bg-[#162d57] transition-colors">
                            Create & Open
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetIconSvg(string icon) => icon switch
    {
        // ── Originals ──
        "file-text"  => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/><polyline points='10 9 9 9 8 9'/></svg>",
        "server"     => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><rect x='2' y='2' width='20' height='8' rx='2' ry='2'/><rect x='2' y='14' width='20' height='8' rx='2' ry='2'/><line x1='6' y1='6' x2='6.01' y2='6'/><line x1='6' y1='18' x2='6.01' y2='18'/></svg>",
        "shield"     => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/></svg>",
        "message"    => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/></svg>",
        "monitor"    => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><rect x='2' y='3' width='20' height='14' rx='2' ry='2'/><line x1='8' y1='21' x2='16' y2='21'/><line x1='12' y1='17' x2='12' y2='21'/></svg>",
        "users"      => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg>",
        "settings"   => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z'/></svg>",
        "tool"       => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/></svg>",
        "database"   => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><ellipse cx='12' cy='5' rx='9' ry='3'/><path d='M21 12c0 1.66-4 3-9 3s-9-1.34-9-3'/><path d='M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5'/></svg>",
        "globe"      => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><circle cx='12' cy='12' r='10'/><line x1='2' y1='12' x2='22' y2='12'/><path d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'/></svg>",
        "mail"       => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'/><polyline points='22,6 12,13 2,6'/></svg>",
        "code"       => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><polyline points='16 18 22 12 16 6'/><polyline points='8 6 2 12 8 18'/></svg>",

        // ── New icons ──
        "clipboard"  => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><path d='M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2'/><rect x='8' y='2' width='8' height='4' rx='1' ry='1'/></svg>",
        "bar-chart"  => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/><line x1='2' y1='20' x2='22' y2='20'/></svg>",
        "trend-up"   => "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='22' height='22'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg>",
