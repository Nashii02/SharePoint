@section Scripts {
    <script>
        // --- Search filter ---
        const searchInput = document.getElementById('globalSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const cards = document.querySelectorAll('.wi-card');
                let visible = 0;
                cards.forEach(card => {
                    const title = card.dataset.title?.toLowerCase() ?? '';
                    const desc  = card.dataset.desc?.toLowerCase() ?? '';
                    const match = !query || title.includes(query) || desc.includes(query);
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                document.getElementById('noResultsMsg').classList.toggle('hidden', visible > 0);
            });
        }

        // --- Add Category Modal ---
        const addModal  = document.getElementById('addCategoryModal');

        function openModal() {
            addModal.classList.remove('hidden');
            addModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            document.getElementById('categoryNameInput').focus();
        }
        function closeModal() {
            addModal.classList.add('hidden');
            addModal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        document.getElementById('addCategoryBtn').addEventListener('click', openModal);
        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
        addModal.addEventListener('click', e => { if (e.target === addModal) closeModal(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

        // --- Icon picker ---
        document.querySelectorAll('.icon-option').forEach(opt => {
            opt.addEventListener('click', function () {
                document.querySelectorAll('.icon-option').forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                document.getElementById('selectedIcon').value = this.dataset.icon;
            });
        });

        // --- Stop delete forms from triggering card navigation ---
        document.querySelectorAll('.stop-prop').forEach(el => {
            el.addEventListener('click', e => e.stopPropagation());
        });

        // --- Confirm delete ---
        document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', e => {
                if (!confirm('Delete this category and all its documents?')) e.preventDefault();
            });
        });

        // Inside your existing cards script
        document.querySelectorAll('.wi-card').forEach(card => {
            card.addEventListener('click', function () {
                registerNavigation();
            });
        });
    </script>
}