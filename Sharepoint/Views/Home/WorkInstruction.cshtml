<!-- Standalone delete form — outside modals -->
<form id="delete-module-form" method="post" action="/Home/DeleteModule" style="display:none;">
    <input type="hidden" name="slug" id="delete-slug" />
</form>

<script>
    /* ─── ADD MODAL ─── */
    function openAddModal() {
        document.getElementById('add-modal').style.cssText = 'display:flex !important;';
        document.body.style.overflow = 'hidden';
    }

    function closeAddModal() {
        document.getElementById('add-modal').style.cssText = 'display:none !important;';
        document.body.style.overflow = '';
    }

    document.getElementById('add-modal').addEventListener('click', function(e) {
        if (e.target === this) closeAddModal();
    });



    

   



    /* ─── ICON PICKERS ─── */
    function updateIconPreview(value) {
        document.getElementById('icon-preview').className = value + ' text-[#1B2A6B] text-base';
    }

    function pickIcon(iconClass) {
        document.getElementById('icon-input').value = iconClass;
        updateIconPreview(iconClass);
    }

    function updateEditIconPreview(value) {
        document.getElementById('edit-icon-preview').className = value + ' text-[#1B2A6B] text-base';
    }

    function pickEditIcon(iconClass) {
        document.getElementById('edit-icon-input').value = iconClass;
        updateEditIconPreview(iconClass);
    }



    /* ─── ESC TO CLOSE ─── */
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { closeAddModal(); closeEditModal(); }
    });



    /* ─── SEARCH ─── */
    function searchModules(query) {
        const q = query.toLowerCase().trim();

        document.querySelectorAll('.module-card').forEach(card => {
            const title = card.getAttribute('data-title') || '';
            card.style.display = title.includes(q) ? '' : 'none';
        });

        document.querySelectorAll('.category-group').forEach(group => {
            const visible = group.querySelectorAll('.module-card:not([style*="display: none"])');
            group.style.display = visible.length === 0 ? 'none' : '';
        });

        document.querySelectorAll('.featured-card').forEach(card => {
            const title = card.getAttribute('data-title') || '';
            card.style.display = title.includes(q) ? '' : 'none';
        });

        const featuredSection = document.getElementById('featured-section');
        if (featuredSection) {
            const vis = featuredSection.querySelectorAll('.featured-card:not([style*="display: none"])');
            featuredSection.style.display = vis.length === 0 && q !== '' ? 'none' : '';
        }

        const noResults  = document.getElementById('no-results');
        const allHidden  = document.querySelectorAll('.module-card:not([style*="display: none"])').length === 0;
        if (noResults) noResults.style.display = allHidden && q !== '' ? 'block' : 'none';
    }



    /* ─── TOGGLE FEATURED ─── */
    let featuredExpanded = false;
    function toggleFeatured() {
        featuredExpanded = !featuredExpanded;
        document.querySelectorAll('.featured-extra').forEach(c => {
            c.style.display = featuredExpanded ? '' : 'none';
        });
        document.getElementById('toggle-featured-label').textContent =
            featuredExpanded ? 'Show less' : 'See all';
        document.getElementById('toggle-featured-icon').className =
            featuredExpanded
                ? 'fa-solid fa-chevron-up text-[8px]'
                : 'fa-solid fa-chevron-down text-[8px]';
    }



    /* -- Category Color -- */
        function pickColor(hex, mode) {
        document.getElementById(mode + '-color-input').value  = hex;
        document.getElementById(mode + '-color-picker').value = hex;
    }

    function clearColor(mode) {
        document.getElementById(mode + '-color-input').value  = '';
        document.getElementById(mode + '-color-picker').value = '#1B2A6B';
    }

           // Rename the modal toggle from toggleFeatured to toggleFeaturedSwitch
    function toggleFeaturedSwitch(mode) {
        const btn   = document.getElementById(mode + '-featured-btn');
        const thumb = document.getElementById(mode + '-featured-thumb');
        const input = document.getElementById(mode + '-featured-value');
        const label = document.getElementById(mode + '-featured-label');

        const isOn = input.value === 'true';

        if (isOn) {
            input.value           = 'false';
            btn.style.background  = '#E5E7EB';
            thumb.style.transform = 'translateX(0)';
            label.textContent     = 'Off — will appear in secondary cards';
            label.className       = 'text-[11px] text-gray-400';
        } else {
            input.value           = 'true';
            btn.style.background  = '#1B2A6B';
            thumb.style.transform = 'translateX(20px)';
            label.textContent     = 'On — will be pinned to featured section';
            label.className       = 'text-[11px] text-[#1B2A6B] font-semibold';
        }
    }



    // Helper to set featured state programmatically (used when opening edit modal)
    function setFeaturedState(mode, value) {
        const btn   = document.getElementById(mode + '-featured-btn');
        const thumb = document.getElementById(mode + '-featured-thumb');
        const input = document.getElementById(mode + '-featured-value');
        const label = document.getElementById(mode + '-featured-label');

        if (value) {
            input.value          = 'true';
            btn.style.background = '#1B2A6B';
            thumb.style.transform = 'translateX(20px)';
            label.textContent    = 'On — will be pinned to featured section';
            label.className      = 'text-[11px] text-[#1B2A6B] font-semibold';
        } else {
            input.value          = 'false';
            btn.style.background = '#E5E7EB';
            thumb.style.transform = 'translateX(0)';
            label.textContent    = 'Off — will appear in secondary cards';
            label.className      = 'text-[11px] text-gray-400';
        }
    }

        /* ─── EDIT MODE ─── */
    let editModeActive = false;

        function toggleEditMode() {
        editModeActive = !editModeActive;

        if (editModeActive) {
            document.querySelectorAll('.module-card').forEach(card => {
                card.style.borderLeftColor = '#f59e0b';
                card.querySelectorAll('.edit-indicator').forEach(el => el.classList.replace('hidden', 'flex'));
            });
        } else {
            document.querySelectorAll('.module-card').forEach(card => {
                card.style.borderLeftColor = 'transparent';
                card.querySelectorAll('.edit-indicator').forEach(el => el.classList.replace('flex', 'hidden'));
            });
        }
    }

    function handleCardClick(card) {
        if (!editModeActive) {
            // Normal navigation
            const slug = card.getAttribute('data-slug');
            window.location.href = `/Home/Module?id=${slug}`;
            return;
        }
        // Edit mode — open modal
        openEditModal(
            card.getAttribute('data-slug'),
            card.getAttribute('data-title'),
            card.getAttribute('data-subtitle'),
            card.getAttribute('data-icon'),
            card.getAttribute('data-category'),
            card.getAttribute('data-color')
        );
    }

    /* ─── EDIT MODAL ─── */
    function openEditModal(slug, title, subtitle, iconClass, category, categoryColor) {
        document.getElementById('edit-slug').value         = slug;
        document.getElementById('delete-slug').value       = slug;
        document.getElementById('edit-title').value        = title;
        document.getElementById('edit-subtitle').value     = subtitle;
        document.getElementById('edit-category').value     = category;
        document.getElementById('edit-icon-input').value   = iconClass;
        document.getElementById('edit-color-input').value  = categoryColor || '';
        document.getElementById('edit-color-picker').value = categoryColor || '#1B2A6B';
        updateEditIconPreview(iconClass);
        document.getElementById('edit-modal').style.cssText = 'display:flex !important;';
        document.body.style.overflow = 'hidden';
    }

    function closeEditModal() {
        document.getElementById('edit-modal').style.cssText = 'display:none !important;';
        document.body.style.overflow = '';
    }

    document.getElementById('edit-modal').addEventListener('click', function(e) {
        if (e.target === this) closeEditModal();
    });

    function confirmDeleteModule() {
        const slug = document.getElementById('delete-slug').value;
        if (!slug) return;
        if (confirm('Delete this module? This will also delete all its files.')) {
            document.getElementById('delete-module-form').submit();
        }
    }

    function toggleAdminDropdown() {
        const dropdown = document.getElementById('admin-dropdown');
        const chevron  = document.getElementById('admin-chevron');
        const isOpen   = dropdown.style.display === 'block';

        dropdown.style.display = isOpen ? 'none' : 'block';
        chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        chevron.style.transition = 'transform 0.15s';
    }

    function closeAdminDropdown() {
        document.getElementById('admin-dropdown').style.display = 'none';
        document.getElementById('admin-chevron').style.transform = '';
    }

    document.addEventListener('click', function(e) {
        const wrapper = document.getElementById('admin-dropdown-wrapper');
        if (wrapper && !wrapper.contains(e.target)) closeAdminDropdown();
    });
</script>
