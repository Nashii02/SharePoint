@model WorkInstructionViewModel

@{
    ViewData["Title"] = "Work Instructions";
}

<!-- Tailwind CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />


    <div class="min-h-screen bg-[#EEF4EE]">

        <!-- HERO SECTION -->
        <section class="bg-[#1C3667] text-white relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 py-10">

                <div class="max-w-xl pl-20">
                    <h1 style="letter-spacing: -1px;" class="text-5xl md:text-7lg font-bold leading-none">
                        WORK <br />
                        INSTRUCTIONS
                    </h1>

                    <!-- DOTS -->
                    <div class="mt-8 space-y-3 flex flex-col items-center">
                        <!-- Row 1 -->
                        <div class="flex gap-3 translate-x-10">
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                        </div>
                        <!-- Row 2 -->
                        <div class="flex gap-3 translate-x-10">
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                        </div>
                    </div>
                </div>

                <!-- Fading logo-->
                <div class="absolute right-10 bottom-50 opacity-10 hidden md:block h-40">
                    <img src="~/images/NoBGLogo.png"
                         class="w-80 h-80 object-contain filter brightness-0 invert translate-y-12" />
                </div>

            </div>
        </section>

    <div class="bg-[#DDF0DD] py-3 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 flex items-center gap-8 justify-content-center">

            <div class="flex items-center gap-2">
                <div class="w-12 h-12 rounded-lg bg-white flex items-center justify-center">
                    <i class="fa-solid fa-table-cells text-[#1C3667] text-xl"></i>
                </div>
                <div>
                    <p class="text-[13px] text-[#4a7c4a] font-medium leading-none">Total Modules</p>
                    <p class="text-md font-bold text-[#1C3667] leading-tight">@Model.TotalModules</p>
                </div>
            </div>

            <div class="w-px h-6 bg-[#b2d9b2]"></div>

            <div class="flex items-center gap-2">
                <div class="w-12 h-12 rounded-lg bg-white flex items-center justify-center">
                    <i class="fa-solid fa-folder text-[#1C3667] text-xl"></i>
                </div>
                <div>
                    <p class="text-[13px] text-[#4a7c4a] font-medium leading-none">Categories</p>
                    <p class="text-md font-bold text-[#1C3667] leading-tight">@Model.TotalCategories</p>
                </div>
            </div>

            <div class="w-px h-6 bg-[#b2d9b2]"></div>

            <div class="flex items-center gap-2">
                <div class="w-12 h-12 rounded-lg bg-white flex items-center justify-center">
                    <i class="fa-solid fa-clock-rotate-left text-[#1C3667] text-xl"></i>
                </div>
                <div>
                    <p class="text-[13px] text-[#4a7c4a] font-medium leading-none">Recently Updated</p>
                    <p class="text-md font-bold text-[#1C3667] leading-tight">@Model.RecentlyUpdatedCount</p>
                </div>
            </div>

        </div>
    </div>

         <!-- Body -->
        <div class="min-h-screen py-16">
            <div class="max-w-7xl mx-auto, px-6 pl-20">
                <!-- Featured Cards (large, top row) -->
            <div id="featured-section">
                @if (Model.FeaturedCards.Any())
                {
                    <div class="flex items-center gap-3 mb-4">
                        <span class="text-[11px] font-bold text-[#1C3667] uppercase tracking-widest">
                            Recently Updated
                        </span>
                        <div class="flex-1" style="height:1px; background:#D1E8D1;"></div>
                    </div>
                }
                <div class="grid grid-cols-2 md:grid-cols-3 gap-5 mb-8">
                    @foreach (var item in Model.FeaturedCards)
                    {
                        var badgeClass = item.StatusColor switch
                        {
                            "updated" => "bg-green-100 text-green-800",
                            "review" => "bg-yellow-100 text-yellow-800",
                            _ => "bg-blue-100 text-blue-800"
                        };

                        <a href="@item.URL"
                           class="featured-card bg-white rounded-xl p-4 hover:shadow-md transition cursor-pointer flex flex-col"
                           data-title="@item.Title.ToLower()"
                           style="border: 1px solid #e5e7eb; border-top: 4px solid #1C3667;">

                            <!-- Icon -->
                            <div class="w-11 h-11 rounded-lg bg-[#DDF0DD] flex items-center justify-center mb-3">
                                <i class="@item.IconClass text-[#1C3667] text-xl"></i>
                            </div>

                            <!-- Title & Subtitle -->
                            <p class="font-bold text-[#1C3667] text-md leading-snug mb-1">@item.Title</p>
                            <p class="text-sm text-gray-400 leading-relaxed flex-1">@item.Subtitle</p>

                            <!-- Footer -->
                            <div class="mt-4 pt-3 flex items-center justify-between"
                                 style="border-top: 0.5px solid #F3F4F6;">
                                <span class="text-[10px] font-semibold px-3 py-1 rounded-full @badgeClass">
                                    @item.Status
                                </span>
                                <span class="text-[10px] text-gray-300">@item.LastUpdated</span>
                            </div>

                        </a>
                    }
                </div>
                </div>

                <!-- Secondary Cards grouped by category -->
                @foreach (var group in Model.GroupedSecondaryCards)
                {
                <div class="category-group" data-category="@group.Key.ToLower()">

                    <!-- Category Eyebrow Divider -->
                    <div class="flex items-center gap-3 mb-4 mt-8">
                        <span class="text-[11px] font-bold text-[#1C3667] uppercase tracking-widest">
                            @group.Key
                        </span>
                        <div class="flex-1" style="height:1px; background:#D1E8D1;"></div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-2">
                        @foreach (var item in group.Value)
                        {
                            <div class="bg-white rounded-xl p-3 hover:shadow-md transition relative module-card"
                                 data-title="@item.Title.ToLower()"
                                 style="border: 1px solid #e5e7eb; border-left: 4px solid #1C3667;"
                                 onmouseenter="this.querySelector('.card-actions').style.opacity='1'"
                                 onmouseleave="this.querySelector('.card-actions').style.opacity='0'">

                                <!-- Action buttons -->
                                <div class="card-actions"
                                     style="position:absolute; top:8px; right:8px; z-index:10; opacity:0; transition: opacity 0.2s; display:flex; gap:4px;">

                                    <!-- Edit button -->
                                    <button type="button"
                                            onclick="openEditModal('@item.URL.Split('=').Last()', '@item.Title', '@item.Subtitle', '@item.IconClass', '@item.Category')"
                                            class="w-6 h-6 rounded-full bg-blue-50 hover:bg-blue-100 flex items-center justify-center">
                                        <i class="fa-solid fa-pen text-blue-400 text-[10px]"></i>
                                    </button>

                                    <!-- Delete button -->
                                    <form method="post" action="/Home/DeleteModule">
                                        <input type="hidden" name="slug" value="@item.URL.Split('=').Last()" />
                                        <button type="submit"
                                                class="w-6 h-6 rounded-full bg-red-50 hover:bg-red-100 flex items-center justify-center"
                                                onclick="return confirm('Delete @item.Title? This will also delete all its files.')">
                                            <i class="fa-solid fa-trash text-red-400 text-[10px]"></i>
                                        </button>
                                    </form>

                                </div>

                                <a href="@item.URL" class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-lg bg-[#DDF0DD] flex items-center justify-center flex-shrink-0">
                                        <i class="@item.IconClass text-[#1C3667] text-2xl"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-bold text-[#1C3667] text-sm leading-snug">@item.Title</p>
                                        <p class="text-[11px] text-gray-400 mt-0.5 leading-snug">@item.Subtitle</p>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                }

                <!-- ADD MODULE CARD — sits below all groups -->
                <div class="mt-4">
                    <button type="button" onclick="openAddModal()"
                            class="bg-white rounded-xl p-4 hover:shadow-md transition cursor-pointer flex items-center gap-3"
                            style="border: 1px dashed #1C3667;">
                        <div class="w-12 h-12 rounded-lg bg-[#DDF0DD] flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-plus text-[#1C3667] text-2xl"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="font-bold text-[#1C3667] text-xs leading-snug">Add Module</p>
                            <p class="text-[11px] text-gray-400 mt-0.5 leading-snug">Click to add a new module</p>
                        </div>
                    </button>
                </div>

            <div id="no-results" style="display:none;"
                 class="text-center py-16 text-gray-400">
                <i class="fa-solid fa-magnifying-glass text-4xl mb-3 block text-gray-200"></i>
                <p class="text-sm font-semibold text-gray-500">No modules found</p>
                <p class="text-xs text-gray-400 mt-1">Try a different search term</p>
            </div>



                <!-- ADD MODULE MODAL -->
                <div id="add-modal"
                     class="fixed inset-0 flex items-center justify-center"
                     style="background: rgba(0,0,0,0.5); display:none; z-index:9999;">

                    <div class="bg-white rounded-xl shadow-xl p-6 overflow-y-auto"
                         style="width: 420px; max-height: 90vh;">

                        <!-- Header -->
                        <div class="flex items-center justify-between mb-5">
                            <p class="text-sm font-bold text-[#1C3667]">Add New Module</p>
                            <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600">
                                <i class="fa-solid fa-xmark text-lg"></i>
                            </button>
                        </div>

                        <!-- Form -->
                        <form method="post" action="/Home/AddModule">

                            <!-- Title -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Title</label>
                                <input type="text" name="title" required placeholder="e.g. Fleet Management"
                                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                            </div>

                            <!-- Subtitle -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Descrition</label>
                                <input type="text" name="subtitle" placeholder="e.g. Manage company vehicles"
                                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                            </div>

                            <!-- Category -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Category</label>
                                <input type="text" name="category"
                                       placeholder="e.g. HR & Finance"
                                       list="category-suggestions"
                                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />

                                <!-- Suggests existing categories as you type -->
                                <datalist id="category-suggestions">
                                    @foreach (var cat in Model.GroupedSecondaryCards.Keys)
                                    {
                                        <option value="@cat"></option>
                                    }
                                </datalist>
                                <p class="text-[10px] text-gray-400 mt-1">Type a new category or pick an existing one</p>
                            </div>

                            <!-- Icon -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Icon Class</label>
                                <div class="flex gap-2">
                                    <input type="text" name="iconClass" id="icon-input"
                                           placeholder="e.g. fa-solid fa-car"
                                           oninput="updateIconPreview(this.value)"
                                           class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                                    <!-- Live preview -->
                                    <div class="w-10 h-10 rounded-lg bg-[#DDF0DD] flex items-center justify-center flex-shrink-0">
                                        <i id="icon-preview" class="fa-solid fa-icons text-[#1C3667] text-lg"></i>
                                    </div>
                                </div>
                                <p class="text-[10px] text-gray-400 mt-1">
                                    Find icons at <a href="https://fontawesome.com/icons" target="_blank" class="underline text-[#1C3667]">fontawesome.com/icons</a>
                                </p>
                            </div>

                            <!-- Quick icon picker -->
                            <div class="mb-5">
                                <p class="text-[10px] text-gray-400 mb-2">Quick pick:</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var icon in new[] {
                                                                "fa-solid fa-server",           "fa-solid fa-coins",            
                                                                    "fa-solid fa-gears",            "fa-solid fa-chart-bar",
                                                                    "fa-solid fa-users-gear",       "fa-solid fa-globe",
                                                                    "fa-regular fa-window-restore", "fa-brands fa-dropbox",
                                                                    "fa-solid fa-file-pen",         "fa-solid fa-chart-column",
                                                                    "fa-regular fa-image",          "fa-solid fa-clipboard-list",
                                                                    "fa-solid fa-people-arrows",    "fa-solid fa-chart-simple",
                                                                    "fa-solid fa-circle-nodes",     "fa-solid fa-desktop",
                                                                    "fa-solid fa-utensils",         "fa-solid fa-key",
                                                                    "fa-solid fa-terminal",         "fa-solid fa-ellipsis",
                                                                    "fa-solid fa-truck",            "fa-solid fa-plane-departure",
                                                                    "fa-solid fa-box",              "fa-solid fa-building",
                                                                    "fa-solid fa-laptop",           "fa-solid fa-file",
                                                                    "fa-solid fa-chart-line",       "fa-solid fa-hotel",
                                                                    "fa-solid fa-gear",             "fa-solid fa-users",
                                                                    "fa-solid fa-person-shelter",   "fa-solid fa-person-running",
                                                                    "fa-solid fa-ticket",           "fa-solid fa-circle-1",
                                                                    "fa-solid fa-infinity"

                                                                    })
                                    {
                                        <button type="button"
                                                onclick="pickIcon('@icon')"
                                                class="w-8 h-8 rounded-md bg-gray-100 hover:bg-[#DDF0DD] flex items-center justify-center transition"
                                                title="@icon">
                                            <i class="@icon text-[#1C3667] text-sm"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Buttons -->
                            <div class="flex gap-2">
                                <button type="button" onclick="closeAddModal()"
                                        class="flex-1 border border-gray-200 text-gray-500 text-xs font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition">
                                    Cancel
                                </button>
                                <button type="submit"
                                        class="flex-1 bg-[#1C3667] text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-[#16305a] transition">
                                    <i class="fa-solid fa-plus mr-1"></i> Add Module
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- EDIT MODULE MODAL -->
                <div id="edit-modal"
                     class="fixed inset-0 flex items-center justify-center"
                     style="background: rgba(0,0,0,0.5); display:none; z-index:9999;">

                    <div class="bg-white rounded-xl shadow-xl p-6 overflow-y-auto"
                         style="width: 420px; max-height: 90vh;">

                        <!-- Header -->
                        <div class="flex items-center justify-between mb-5">
                            <p class="text-sm font-bold text-[#1C3667]">Edit Module</p>
                            <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-600">
                                <i class="fa-solid fa-xmark text-lg"></i>
                            </button>
                        </div>

                        <form method="post" action="/Home/EditModule">
                            <input type="hidden" name="slug" id="edit-slug" />

                            <!-- Title -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Title</label>
                                <input type="text" name="title" id="edit-title" required
                                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                            </div>

                            <!-- Subtitle -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Description</label>
                                <input type="text" name="subtitle" id="edit-subtitle"
                                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                            </div>

                            <!-- Category -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Category</label>
                                <input type="text" name="category" id="edit-category"
                                       list="edit-category-suggestions"
                                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                                <datalist id="edit-category-suggestions">
                                    @foreach (var cat in Model.GroupedSecondaryCards.Keys)
                                    {
                                        <option value="@cat"></option>
                                    }
                                </datalist>
                            </div>

                            <!-- Icon -->
                            <div class="mb-4">
                                <label class="text-xs font-semibold text-[#1C3667] block mb-1">Icon Class</label>
                                <div class="flex gap-2">
                                    <input type="text" name="iconClass" id="edit-icon-input"
                                           oninput="updateEditIconPreview(this.value)"
                                           class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:border-[#1C3667]" />
                                    <div class="w-10 h-10 rounded-lg bg-[#DDF0DD] flex items-center justify-center flex-shrink-0">
                                        <i id="edit-icon-preview" class="fa-solid fa-icons text-[#1C3667] text-lg"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick icon picker -->
                            <div class="mb-5">
                                <p class="text-[10px] text-gray-400 mb-2">Quick pick:</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var icon in new[] {
                                                                "fa-solid fa-server",           "fa-solid fa-coins",
                                                                "fa-solid fa-gears",            "fa-solid fa-chart-bar",
                                                                "fa-solid fa-users-gear",       "fa-solid fa-globe",
                                                                "fa-regular fa-window-restore", "fa-brands fa-dropbox",
                                                                "fa-solid fa-file-pen",         "fa-solid fa-chart-column",
                                                                "fa-regular fa-image",          "fa-solid fa-clipboard-list",
                                                                "fa-solid fa-people-arrows",    "fa-solid fa-chart-simple",
                                                                "fa-solid fa-circle-nodes",     "fa-solid fa-desktop",
                                                                "fa-solid fa-utensils",         "fa-solid fa-key",
                                                                "fa-solid fa-terminal",         "fa-solid fa-ellipsis",
                                                                "fa-solid fa-truck",            "fa-solid fa-plane-departure",
                                                                "fa-solid fa-box",              "fa-solid fa-building",
                                                                "fa-solid fa-laptop",           "fa-solid fa-file",
                                                                "fa-solid fa-chart-line",       "fa-solid fa-hotel",
                                                                "fa-solid fa-gear",             "fa-solid fa-users",
                                                                "fa-solid fa-person-shelter",   "fa-solid fa-person-running",
                                                                "fa-solid fa-ticket",           "fa-solid fa-circle-1",
                                                                "fa-solid fa-infinity"
                                                                    })
                                    {
                                        <button type="button"
                                                onclick="pickEditIcon('@icon')"
                                                class="w-8 h-8 rounded-md bg-gray-100 hover:bg-[#DDF0DD] flex items-center justify-center transition"
                                                title="@icon">
                                            <i class="@icon text-[#1C3667] text-sm"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Buttons -->
                            <div class="flex gap-2">
                                <button type="button" onclick="closeEditModal()"
                                        class="flex-1 border border-gray-200 text-gray-500 text-xs font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition">
                                    Cancel
                                </button>
                                <button type="submit"
                                        class="flex-1 bg-[#1C3667] text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-[#16305a] transition">
                                    <i class="fa-solid fa-floppy-disk mr-1"></i> Save Changes
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>

    </div>

<script>
    function openAddModal() {
        document.getElementById('add-modal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeAddModal() {
        document.getElementById('add-modal').style.display = 'none';
        document.body.style.overflow = '';
    }

    function updateIconPreview(value) {
        const preview = document.getElementById('icon-preview');
        preview.className = value + ' text-[#1C3667] text-lg';
    }

    function pickIcon(iconClass) {
        document.getElementById('icon-input').value = iconClass;
        updateIconPreview(iconClass);
    }

    // Close when clicking outside
    document.getElementById('add-modal').addEventListener('click', function (e) {
        if (e.target === this) closeAddModal();
    });

        function openEditModal(slug, title, subtitle, iconClass, category) {
        document.getElementById('edit-slug').value = slug;
        document.getElementById('edit-title').value = title;
        document.getElementById('edit-subtitle').value = subtitle;
        document.getElementById('edit-category').value = category;
        document.getElementById('edit-icon-input').value = iconClass;
        updateEditIconPreview(iconClass);
        document.getElementById('edit-modal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeEditModal() {
        document.getElementById('edit-modal').style.display = 'none';
        document.body.style.overflow = '';
    }

    function updateEditIconPreview(value) {
        document.getElementById('edit-icon-preview').className = value + ' text-[#1C3667] text-lg';
    }

    function pickEditIcon(iconClass) {
        document.getElementById('edit-icon-input').value = iconClass;
        updateEditIconPreview(iconClass);
    }

    document.getElementById('edit-modal').addEventListener('click', function (e) {
        if (e.target === this) closeEditModal();
    });


        function searchModules(query) {
        const q = query.toLowerCase().trim();

        // Show/hide individual cards
        document.querySelectorAll('.module-card').forEach(card => {
            const title = card.getAttribute('data-title') || '';
            card.style.display = title.includes(q) ? '' : 'none';
        });

        // Hide category group entirely if all its cards are hidden
        document.querySelectorAll('.category-group').forEach(group => {
            const visibleCards = group.querySelectorAll('.module-card:not([style*="display: none"])');
            group.style.display = visibleCards.length === 0 ? 'none' : '';
        });

        // Show/hide featured cards too
        document.querySelectorAll('.featured-card').forEach(card => {
            const title = card.getAttribute('data-title') || '';
            card.style.display = title.includes(q) ? '' : 'none';
        });

        // Hide the "Recently Updated" header if no featured cards are visible
        const featuredSection = document.getElementById('featured-section');
        if (featuredSection) {
            const visibleFeatured = featuredSection.querySelectorAll('.featured-card:not([style*="display: none"])');
            featuredSection.style.display = visibleFeatured.length === 0 && q !== '' ? 'none' : '';
        }

        // Show no-results message
        const noResults = document.getElementById('no-results');
        const allHidden = document.querySelectorAll('.module-card:not([style*="display: none"])').length === 0;
        if (noResults) noResults.style.display = allHidden && q !== '' ? 'block' : 'none';
    }
</script>